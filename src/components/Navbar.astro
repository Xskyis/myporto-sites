---
import { Icon } from "astro-icon/components";
import { PROFILE } from "../data/profile";
import { SOCIALS } from "../data/socials";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
const isHome = currentPath === "/";
const isProjectDetail = currentPath.startsWith("/projects");

const NAV_ITEMS = [
  { id: "about", index: "01", label: "About", mobileLabel: "About" },
  { id: "projects", index: "02", label: "Projects", mobileLabel: "Projects" },
  { id: "tech-stack", index: "03", label: "Stack", mobileLabel: "Tech Stack" },
  { id: "contact", index: "04", label: "Contact", mobileLabel: "Contact" },
] as const;
---

<header
  id="main-header"
  data-scrolled="false"
  data-menu-open="false"
  class="nav-header fixed top-0 left-0 w-full z-50"
>
  <!-- Reading progress rail (revealed once scrolled past the top fold) -->
  <div class="nav-progress-track" aria-hidden="true">
    <div
      id="scroll-progress-bar"
      class="w-full h-full bg-[var(--accent-primary)] origin-left"
      style="transform: scaleX(0);"
    >
    </div>
  </div>

  <div class="nav-frame w-full">
    <nav
      id="nav-shell"
      class="nav-shell max-w-7xl mx-auto px-5 sm:px-6 md:px-12 lg:px-16 h-16 md:h-20 flex items-center justify-between gap-2 md:gap-4"
      aria-label="Main Navigation"
    >
      <!-- Logo / Monogram -->
      <a
        href={isHome ? "#hero" : "/"}
        class="nav-scroll-trigger group flex items-center shrink-0 text-[var(--text-primary)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--border-focus)] rounded-sm"
        aria-label="Achmad Nabil Afgareza - Home"
      >
        <span class="font-display font-bold text-xl md:text-[22px] tracking-[-0.035em] leading-none">
          <span>nabil</span><span class="text-[var(--accent-primary)]">.</span>
        </span>
      </a>

      <!-- Desktop Navigation Links with Sliding Active Indicator Pill -->
      <div
        id="nav-links-track"
        class="relative hidden md:flex items-center gap-0.5 p-1 rounded-full border border-hairline bg-[var(--bg-surface-soft)]/50 text-[var(--text-muted)] transition-[border-color,background-color] duration-300"
      >
        <!-- Sliding active indicator pill -->
        <div
          id="nav-active-indicator"
          class="absolute left-0 top-1 bottom-1 rounded-full border border-hairline shadow-xs pointer-events-none opacity-0 will-change-transform"
          aria-hidden="true"
        >
        </div>

        {
          NAV_ITEMS.map((item) => {
            const activeOnRoute = isProjectDetail && item.id === "projects";
            return (
              <a
                href={isHome ? `#${item.id}` : `/#${item.id}`}
                data-section={item.id}
                data-route-active={activeOnRoute ? "true" : undefined}
                aria-current={activeOnRoute ? "page" : undefined}
                class="nav-link relative z-10 h-7 px-3.5 rounded-full inline-flex items-center text-[13px] font-medium tracking-[-0.01em] hover:text-[var(--text-primary)] transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-[var(--border-focus)]"
              >
                <span class="nav-index font-mono text-[11px] tabular-nums text-[var(--accent-text)] mr-1.5" aria-hidden="true">
                  {item.index}
                </span>
                <span>{item.label}</span>
              </a>
            );
          })
        }
      </div>

      <!-- Controls: Palette Switcher + Theme Toggle + Mobile Menu Button -->
      <div class="flex items-center gap-1.5 md:gap-2 shrink-0">
        <!-- Dual Palette Segmented Pill Switcher (Mono / Color) -->
        <div
          id="palette-controls"
          hidden
          class="flex items-center rounded-full p-0.5 border border-hairline bg-[var(--bg-surface-soft)]/60"
          role="group"
          aria-label="Visual Palette Theme Switcher"
        >
          <button
            type="button"
            id="btn-palette-mono"
            class="palette-btn h-7 md:h-8 px-2.5 md:px-3 rounded-full text-xs font-medium tracking-[-0.01em] flex items-center justify-center gap-1.5 transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--border-focus)]"
            aria-pressed="true"
            aria-label="Switch to Monochrome Minimalist Theme"
          >
            <span
              class="w-2 h-2 rounded-full border border-hairline bg-[var(--text-primary)] shrink-0"
              aria-hidden="true"></span>
            <span>Mono</span>
          </button>

          <button
            type="button"
            id="btn-palette-color"
            class="palette-btn h-7 md:h-8 px-2.5 md:px-3 rounded-full text-xs font-medium tracking-[-0.01em] flex items-center justify-center gap-1.5 transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--border-focus)]"
            aria-pressed="false"
            aria-label="Switch to Poster Color Palette (Marine Blue + Red + Cream)"
          >
            <span
              class="w-2 h-2 rounded-full bg-[var(--swatch-color)] shrink-0"
              aria-hidden="true"></span>
            <span>Color</span>
          </button>
        </div>

        <!-- Light / Dark Toggle (Active in Monochrome Mode) -->
        <button
          type="button"
          id="btn-tone-toggle"
          hidden
          class="w-8 h-8 md:w-9 md:h-9 shrink-0 rounded-full border border-hairline bg-[var(--bg-surface-soft)]/40 hover:bg-[var(--bg-surface-soft)] flex items-center justify-center text-[var(--text-primary)] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--border-focus)]"
          aria-label="Toggle Light / Dark Tone"
        >
          <span
            class="tone-icon-moon flex items-center justify-center pointer-events-none"
            aria-hidden="true"
          >
            <Icon name="lucide:moon" class="w-4 h-4 pointer-events-none" />
          </span>
          <span
            class="tone-icon-sun hidden items-center justify-center pointer-events-none"
            aria-hidden="true"
          >
            <Icon name="lucide:sun" class="w-4 h-4 pointer-events-none" />
          </span>
        </button>

        <!-- Mobile Menu Toggle Button -->
        <button
          type="button"
          id="btn-mobile-menu"
          hidden
          class="md:hidden w-9 h-9 shrink-0 rounded-full border border-hairline flex items-center justify-center text-[var(--text-primary)] hover:bg-[var(--bg-surface-soft)] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--border-focus)]"
          aria-expanded="false"
          aria-controls="mobile-menu-overlay"
          aria-label="Open Navigation Menu"
        >
          <Icon
            name="lucide:menu"
            class="w-4 h-4 menu-icon-open"
            aria-hidden="true"
          />
          <Icon
            name="lucide:x"
            class="w-4 h-4 menu-icon-close hidden"
            aria-hidden="true"
          />
        </button>

        <!-- Native navigation remains usable before enhancement or without JavaScript. -->
        <details id="mobile-nav-fallback" class="md:hidden">
          <summary
            aria-label="Navigation menu"
            class="w-9 h-9 rounded-full border border-hairline flex items-center justify-center text-[var(--text-primary)] cursor-pointer list-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--border-focus)] [&::-webkit-details-marker]:hidden"
          >
            <Icon name="lucide:menu" class="w-4 h-4" aria-hidden="true" />
          </summary>
          <nav
            aria-label="Section Navigation"
            class="absolute top-16 left-4 right-4 flex flex-col gap-1 rounded-2xl border border-hairline bg-[var(--bg-primary)] p-3 shadow-lg"
          >
            {
              NAV_ITEMS.map((item) => (
                <a
                  href={`${isHome ? "" : "/"}#${item.id}`}
                  class="px-4 py-3 rounded-lg text-[var(--text-primary)] hover:bg-[var(--bg-surface-soft)] focus-visible:outline-2 focus-visible:outline-[var(--border-focus)]"
                >
                  {item.mobileLabel}
                </a>
              ))
            }
          </nav>
        </details>
      </div>
    </nav>
  </div>
</header>

<!-- Fullscreen Mobile Menu Overlay with Solid Opaque Background (Sibling of Header) -->
<div
  id="mobile-menu-overlay"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile navigation menu"
  class="fixed inset-0 top-16 z-40 hidden flex-col justify-between px-6 pt-8 pb-8 border-t-hairline overflow-y-auto"
  style="background-color: var(--bg-primary);"
  aria-hidden="true"
  data-lenis-prevent
>
  <div class="flex flex-col">
    {
      NAV_ITEMS.map((item) => {
        const activeOnRoute = isProjectDetail && item.id === "projects";
        return (
          <a
            href={isHome ? `#${item.id}` : `/#${item.id}`}
            data-section={item.id}
            data-route-active={activeOnRoute ? "true" : undefined}
            aria-current={activeOnRoute ? "page" : undefined}
            class="mobile-nav-link py-5 border-b-hairline flex items-baseline justify-between gap-4 text-[var(--text-primary)] hover:text-[var(--accent-text)] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--border-focus)] rounded-sm"
          >
            <span class="text-2xl sm:text-3xl font-display font-semibold tracking-[-0.025em]">
              {item.mobileLabel}
            </span>
            <span class="mobile-nav-index font-mono text-xs tabular-nums text-[var(--text-muted)]">
              {item.index}
            </span>
          </a>
        );
      })
    }
  </div>

  <div class="pt-6 text-xs text-[var(--text-muted)] flex flex-col gap-2">
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
      {
        SOCIALS.map((soc, idx) => (
          <>
            {idx > 0 && <span aria-hidden="true">·</span>}
            <a
              href={soc.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${soc.name}: ${soc.label}`}
              class="text-[var(--text-primary)] hover:text-[var(--accent-text)] hover:underline underline-offset-4 transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-[var(--border-focus)] rounded-sm"
            >
              {soc.name}
            </a>
          </>
        ))
      }
    </div>
    <p class="text-[11px]">
      {PROFILE.name} · {PROFILE.location.replace(", East Java", "")}
    </p>
  </div>
</div>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { scrollToTarget } from "../lib/scroll/lenis";
  import { scrollLock } from "../lib/scroll/scroll-lock";
  import { getSamePageHash } from "../lib/scroll/navbar-link";
  import { onPaletteChange } from "../lib/palette-events";
  import { setupThemeTransition } from "../lib/theme-transition";
  import {
    focusNavigationTarget,
    setupMobileMenu,
  } from "../lib/scroll/navbar-menu";

  gsap.registerPlugin(ScrollTrigger);

  let navAbortController: AbortController | null = null;
  let navScrollTriggers: ScrollTrigger[] = [];

  const releaseBodyScrollLock = () => {
    document.body.style.overflow = "";
    scrollLock.release("mobile-menu");
  };

  function setupNavbar() {
    releaseBodyScrollLock();

    if (navAbortController) {
      navAbortController.abort();
    }
    navAbortController = new AbortController();
    const { signal } = navAbortController;

    navScrollTriggers.forEach((st) => st.kill());
    navScrollTriggers = [];

    const html = document.documentElement;
    const btnMono = document.getElementById("btn-palette-mono");
    const btnColor = document.getElementById("btn-palette-color");
    const btnTone = document.getElementById("btn-tone-toggle");
    const btnMobile = document.getElementById("btn-mobile-menu");
    const mobileNavFallback = document.getElementById("mobile-nav-fallback");
    const paletteControls = document.getElementById("palette-controls");
    const main = document.getElementById("main-content");
    const mobileMenu = document.getElementById("mobile-menu-overlay");
    const desktopLinks =
      document.querySelectorAll<HTMLAnchorElement>(".nav-link");
    const mobileLinks =
      document.querySelectorAll<HTMLAnchorElement>(".mobile-nav-link");
    const header = document.getElementById("main-header");
    const navShell = document.getElementById("nav-shell");
    const activeIndicator = document.getElementById("nav-active-indicator");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const isReduced = () => reducedMotion.matches;
    let requestedPalette: "mono" | "color" =
      html.dataset.palette === "color" ? "color" : "mono";
    let requestedDark = html.classList.contains("dark");
    let toneRequested = false;
    const fallbackHasFocus =
      mobileNavFallback?.contains(document.activeElement) ?? false;
    let navbarOwnsMainInert = false;

    paletteControls?.removeAttribute("hidden");
    btnTone?.removeAttribute("hidden");
    btnMobile?.removeAttribute("hidden");
    mobileNavFallback?.setAttribute("hidden", "");
    if (fallbackHasFocus) btnMobile?.focus({ preventScroll: true });

    // 0.1 Adaptive Header State (mobile & desktop floating pill + bottom-of-page contact highlight)
    let isScrolledState = header?.dataset.scrolled === "true";
    let isMenuOpenState = header?.dataset.menuOpen === "true";
    let scrollTargetLock: string | null = null;
    let lockTimer: number | null = null;

    const clearScrollTargetLock = () => {
      scrollTargetLock = null;
      if (lockTimer !== null) {
        window.clearTimeout(lockTimer);
        lockTimer = null;
      }
    };

    const lockScrollTarget = (sectionId: string) => {
      clearScrollTargetLock();
      scrollTargetLock = sectionId;
      lockTimer = window.setTimeout(clearScrollTargetLock, 1800);
    };

    const SCROLL_KEYS = new Set([
      "ArrowUp",
      "ArrowDown",
      "PageUp",
      "PageDown",
      "Home",
      "End",
      " ",
      "Spacebar",
    ]);
    window.addEventListener("wheel", clearScrollTargetLock, {
      passive: true,
      signal,
    });
    window.addEventListener("touchstart", clearScrollTargetLock, {
      passive: true,
      signal,
    });
    window.addEventListener(
      "keydown",
      (e) => {
        if (SCROLL_KEYS.has(e.key)) clearScrollTargetLock();
      },
      { signal },
    );
    signal.addEventListener("abort", clearScrollTargetLock, { once: true });

    const contactLink = Array.from(desktopLinks).find(
      (item) => item.dataset.section === "contact",
    );
    const canTrackContact =
      Boolean(document.getElementById("contact")) &&
      Boolean(
        contactLink && getSamePageHash(contactLink.href, window.location.href),
      );

    const updateHeaderState = () => {
      const nextScrolled = window.scrollY > 20;
      const nextMenuOpen = mobileMenu
        ? !mobileMenu.classList.contains("hidden")
        : false;
      if (header) {
        if (nextScrolled !== isScrolledState) {
          isScrolledState = nextScrolled;
          header.dataset.scrolled = String(nextScrolled);
        }
        if (nextMenuOpen !== isMenuOpenState) {
          isMenuOpenState = nextMenuOpen;
          header.dataset.menuOpen = String(nextMenuOpen);
        }
      }
      if (
        scrollTargetLock === null &&
        canTrackContact &&
        contactLink &&
        window.scrollY > 20 &&
        window.innerHeight + window.scrollY >=
          document.documentElement.scrollHeight - 8
      ) {
        if (contactLink.getAttribute("aria-current") !== "location") {
          moveIndicatorTo(contactLink, true);
        }
      }
    };

    window.addEventListener("scroll", updateHeaderState, {
      passive: true,
      signal,
    });

    const menuController =
      mobileMenu && btnMobile
        ? setupMobileMenu({
            menu: mobileMenu,
            button: btnMobile,
            signal,
            onStateChange: () => {
              updateHeaderState();
              const menuOpen = mobileMenu
                ? !mobileMenu.classList.contains("hidden")
                : false;
              if (menuOpen && main && !main.inert) {
                main.inert = true;
                navbarOwnsMainInert = true;
              } else if (!menuOpen && main && navbarOwnsMainInert) {
                main.inert = false;
                navbarOwnsMainInert = false;
              }
            },
          })
        : null;

    // 1. Sliding Indicator Positioning (GPU-composited x + width)
    let indicatorVisible = false;
    const moveIndicatorTo = (
      targetLink: HTMLElement | null,
      animate = true,
    ) => {
      desktopLinks.forEach((link) => {
        link.classList.remove("text-[var(--text-primary)]");
        if (link.dataset.routeActive === "true") {
          link.setAttribute("aria-current", "page");
        } else {
          link.removeAttribute("aria-current");
        }
      });
      mobileLinks.forEach((link) => {
        if (link.dataset.routeActive === "true") {
          link.setAttribute("aria-current", "page");
        } else {
          link.removeAttribute("aria-current");
        }
      });

      if (!activeIndicator) return;

      if (!targetLink) {
        indicatorVisible = false;
        if (isReduced()) gsap.set(activeIndicator, { opacity: 0 });
        else
          gsap.to(activeIndicator, {
            opacity: 0,
            duration: 0.2,
            overwrite: true,
          });
        return;
      }

      targetLink.classList.add("text-[var(--text-primary)]");
      targetLink.setAttribute(
        "aria-current",
        targetLink.dataset.routeActive === "true" ? "page" : "location",
      );
      const section = targetLink.dataset.section;
      mobileLinks.forEach((link) => {
        if (section && link.dataset.section === section) {
          link.setAttribute(
            "aria-current",
            link.dataset.routeActive === "true" ? "page" : "location",
          );
        }
      });

      const width = targetLink.offsetWidth;
      if (width === 0) return;
      const left = targetLink.offsetLeft;

      if (!animate || isReduced()) {
        indicatorVisible = true;
        gsap.set(activeIndicator, { x: left, width, opacity: 1 });
      } else if (!indicatorVisible) {
        indicatorVisible = true;
        gsap.set(activeIndicator, { x: left, width });
        gsap.to(activeIndicator, {
          opacity: 1,
          duration: 0.22,
          ease: "power2.out",
          overwrite: true,
        });
      } else {
        gsap.to(activeIndicator, {
          x: left,
          width,
          opacity: 1,
          duration: 0.36,
          ease: "power3.out",
          overwrite: true,
        });
      }
    };

    const routeActiveLink = Array.from(desktopLinks).find(
      (link) => link.dataset.routeActive === "true",
    );
    if (routeActiveLink) {
      moveIndicatorTo(routeActiveLink, false);
    }

    // 2. Click Navigation & Smooth Scroll with Feedback
    const handleNavClick = (
      e: MouseEvent,
      targetLink: HTMLAnchorElement,
      isMobileLink = false,
    ) => {
      const href = targetLink.getAttribute("href");
      if (!href) return;
      // Preserve modified/new-tab clicks and cross-page routes. A project page
      // has its own #contact section, so /#contact must remain a home-page link.
      if (
        e.defaultPrevented ||
        e.button !== 0 ||
        e.metaKey ||
        e.ctrlKey ||
        e.shiftKey ||
        e.altKey
      )
        return;
      const hash = getSamePageHash(href, window.location.href);
      if (!hash) return;
      const targetElement = document.querySelector<HTMLElement>(hash);

      if (targetElement) {
        e.preventDefault();

        const sectionId = targetLink.dataset.section;
        if (sectionId) lockScrollTarget(sectionId);

        if (!isReduced()) {
          gsap.fromTo(
            targetLink,
            { scale: 0.96 },
            { scale: 1, duration: 0.2, ease: "power2.out" },
          );
        }

        if (isMobileLink) {
          menuController?.close({
            restoreFocus: false,
            onComplete: () => {
              scrollToTarget(hash, {
                onComplete: () => {
                  clearScrollTargetLock();
                  focusNavigationTarget(targetElement, signal);
                },
              });
            },
          });
        } else {
          moveIndicatorTo(targetLink, true);
          scrollToTarget(hash, {
            onComplete: () => {
              clearScrollTargetLock();
              focusNavigationTarget(targetElement, signal);
            },
          });
        }
      }
    };

    desktopLinks.forEach((link) => {
      link.addEventListener("click", (e) => handleNavClick(e, link, false), {
        signal,
      });
    });

    mobileLinks.forEach((link) => {
      link.addEventListener("click", (e) => handleNavClick(e, link, true), {
        signal,
      });
    });

    const extraScrollTriggers = document.querySelectorAll<HTMLAnchorElement>(
      ".nav-scroll-trigger",
    );
    extraScrollTriggers.forEach((trigger) => {
      trigger.addEventListener(
        "click",
        (e) => {
          if (
            e.defaultPrevented ||
            e.button !== 0 ||
            e.metaKey ||
            e.ctrlKey ||
            e.shiftKey ||
            e.altKey
          )
            return;
          const href = trigger.getAttribute("href");
          if (href && href.startsWith("#")) {
            e.preventDefault();
            const target = document.querySelector<HTMLElement>(href);
            if (href === "#hero") {
              lockScrollTarget("hero");
              moveIndicatorTo(null, true);
            }
            scrollToTarget(href, {
              onComplete: () => {
                if (href === "#hero") clearScrollTargetLock();
                if (target) focusNavigationTarget(target, signal);
              },
            });
          }
        },
        { signal },
      );
    });

    // 3. ScrollTrigger-driven Active Section Tracking
    const sections = ["about", "projects", "tech-stack", "contact"];
    sections.forEach((id) => {
      const sectionEl = document.getElementById(id);
      const link = Array.from(desktopLinks).find(
        (item) => item.dataset.section === id,
      );
      if (
        sectionEl &&
        link &&
        getSamePageHash(link.href, window.location.href)
      ) {
        const st = ScrollTrigger.create({
          trigger: sectionEl,
          start: "top 45%",
          end: "bottom 45%",
          onEnter: () => {
            if (scrollTargetLock !== null) return;
            const activeLink = document.querySelector<HTMLAnchorElement>(
              `.nav-link[data-section="${id}"]`,
            );
            moveIndicatorTo(activeLink, true);
          },
          onEnterBack: () => {
            if (scrollTargetLock !== null) return;
            const activeLink = document.querySelector<HTMLAnchorElement>(
              `.nav-link[data-section="${id}"]`,
            );
            moveIndicatorTo(activeLink, true);
          },
        });
        navScrollTriggers.push(st);
      }
    });

    const heroEl = document.getElementById("hero");
    if (heroEl) {
      const st = ScrollTrigger.create({
        trigger: heroEl,
        start: "top top",
        end: "bottom 50%",
        onEnter: () => {
          if (scrollTargetLock !== null) return;
          moveIndicatorTo(null, true);
        },
        onEnterBack: () => {
          if (scrollTargetLock !== null) return;
          moveIndicatorTo(null, true);
        },
      });
      navScrollTriggers.push(st);
    }

    // 5. Theme Palette & Tone Controls
    const updateButtonsUI = () => {
      const currentPalette = html.getAttribute("data-palette") || "mono";
      const isMono = currentPalette === "mono";

      if (btnMono && btnColor) {
        btnMono.setAttribute("aria-pressed", isMono ? "true" : "false");
        btnColor.setAttribute("aria-pressed", !isMono ? "true" : "false");
      }

      if (btnTone) btnTone.hidden = !isMono;
    };

    const updateToneUI = () => {
      const isDark = html.classList.contains("dark");
      if (btnTone) {
        btnTone.setAttribute("aria-pressed", isDark ? "true" : "false");
        btnTone.setAttribute(
          "aria-label",
          isDark ? "Switch to Light Tone" : "Switch to Dark Tone",
        );
        const sun = btnTone.querySelector(".tone-icon-sun");
        const moon = btnTone.querySelector(".tone-icon-moon");
        if (isDark) {
          sun?.classList.remove("hidden");
          sun?.classList.add("flex");
          moon?.classList.add("hidden");
          moon?.classList.remove("flex");
        } else {
          moon?.classList.remove("hidden");
          moon?.classList.add("flex");
          sun?.classList.add("hidden");
          sun?.classList.remove("flex");
        }
      }
    };

    updateButtonsUI();
    updateToneUI();
    updateHeaderState();

    const alignIndicator = () => {
      const current = Array.from(desktopLinks).find((link) =>
        link.hasAttribute("aria-current"),
      );
      if (current) moveIndicatorTo(current, false);
    };
    const offPalette = onPaletteChange(() => {
      updateButtonsUI();
      updateToneUI();
      alignIndicator();
    });
    window.addEventListener(
      "palette-change",
      (event) => {
        const detail = (event as CustomEvent<{ source?: string }>).detail;
        if (detail?.source === "system")
          requestedDark = html.classList.contains("dark");
      },
      { signal },
    );
    window.addEventListener("resize", alignIndicator, {
      passive: true,
      signal,
    });
    navShell?.addEventListener(
      "transitionend",
      (e) => {
        if (e.target === navShell) alignIndicator();
      },
      { signal },
    );
    document.fonts?.ready
      .then(() => {
        if (!signal.aborted) alignIndicator();
      })
      .catch(() => {});

    signal.addEventListener(
      "abort",
      () => {
        offPalette();
        if (activeIndicator) gsap.killTweensOf(activeIndicator);
        desktopLinks.forEach((link) => gsap.killTweensOf(link));
        mobileLinks.forEach((link) => gsap.killTweensOf(link));
      },
      { once: true },
    );

    const runThemeViewTransition = setupThemeTransition(signal, reducedMotion);

    const persistPreference = (key: string, value: string) => {
      try {
        localStorage.setItem(key, value);
      } catch {
        // Keep this page's visual preference when browser storage is unavailable.
      }
    };

    reducedMotion.addEventListener(
      "change",
      () => {
        if (!reducedMotion.matches) return;
        if (activeIndicator) gsap.killTweensOf(activeIndicator);
        desktopLinks.forEach((link) => gsap.killTweensOf(link));
        document.documentElement.classList.remove("theme-transitioning");
      },
      { signal },
    );

    const switchPalette = (
      newPalette: "mono" | "color",
      event?: MouseEvent,
    ) => {
      if (requestedPalette === newPalette) return;
      requestedPalette = newPalette;
      const dark = requestedDark;

      const apply = () => {
        html.setAttribute("data-palette", newPalette);
        html.classList.toggle("dark", dark);
        persistPreference("theme-palette", newPalette);
        if (toneRequested)
          persistPreference("theme-tone", dark ? "dark" : "light");
        updateButtonsUI();
        updateToneUI();
        window.dispatchEvent(
          new CustomEvent("palette-change", {
            detail: { palette: newPalette },
          }),
        );
      };

      runThemeViewTransition(apply, event);
    };

    btnMono?.addEventListener("click", (e) => switchPalette("mono", e), {
      signal,
    });
    btnColor?.addEventListener("click", (e) => switchPalette("color", e), {
      signal,
    });

    // Single source of truth for dark/light toggle (with matching circular View Transition)
    btnTone?.addEventListener(
      "click",
      (e) => {
        e.preventDefault();
        e.stopPropagation();
        requestedDark = !requestedDark;
        requestedPalette = "mono";
        toneRequested = true;
        const dark = requestedDark;

        const apply = () => {
          const currentPalette = html.getAttribute("data-palette") || "mono";
          if (currentPalette !== "mono") {
            html.setAttribute("data-palette", "mono");
            persistPreference("theme-palette", "mono");
            updateButtonsUI();
          }

          const isDark = html.classList.toggle("dark", dark);
          persistPreference("theme-tone", isDark ? "dark" : "light");
          updateToneUI();
          window.dispatchEvent(
            new CustomEvent("palette-change", {
              detail: { tone: isDark ? "dark" : "light" },
            }),
          );
        };

        runThemeViewTransition(apply, e);
      },
      { signal },
    );
  }

  // Register on astro:page-load and clean up on before-swap
  document.addEventListener("astro:page-load", setupNavbar);
  document.addEventListener("astro:before-swap", () => {
    if (navAbortController) {
      navAbortController.abort();
      navAbortController = null;
    }
    navScrollTriggers.forEach((st) => st.kill());
    navScrollTriggers = [];

    releaseBodyScrollLock();
  });
</script>

