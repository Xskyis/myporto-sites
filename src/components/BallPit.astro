---
// BallPit.astro - 3D Interactive Floating Bubble Pit for Footer
---

<div id="ball-pit-wrapper" class="absolute inset-0 w-full h-full overflow-hidden pointer-events-auto z-0" aria-hidden="true">
  <!-- Interactive WebGL Canvas -->
  <canvas
    id="ball-pit-canvas"
    class="w-full h-full block relative z-0 opacity-0 transition-opacity duration-700 select-none"
    style="touch-action: pan-y;"
    aria-label="Interactive 3D Floating Bubble Pit background"
  ></canvas>

  <!-- Soft translucent scrim + desktop-only subtle blur so foreground text stays crisp -->
  <div
    class="ball-pit-veil pointer-events-none absolute inset-0 z-[1]"
    style="background: linear-gradient(180deg, var(--bg-primary) 0%, color-mix(in srgb, var(--bg-primary) 55%, transparent) 22%, color-mix(in srgb, var(--bg-primary) 16%, transparent) 100%);"
    aria-hidden="true"
  ></div>

  <!-- Fallback for prefers-reduced-motion, save-data, or unsupported WebGL -->
  <div id="ball-pit-fallback" class="hidden absolute inset-0 z-0 flex items-center justify-around p-8 gap-6 flex-wrap overflow-hidden opacity-25" aria-hidden="true">
    <div class="w-16 h-16 rounded-full border border-[var(--text-muted)] bg-[var(--text-primary)]/5"></div>
    <div class="w-12 h-12 rounded-full border border-[var(--text-muted)] bg-[var(--accent-primary)]/10"></div>
    <div class="w-20 h-20 rounded-full border border-[var(--text-muted)] bg-[var(--text-primary)]/5"></div>
    <div class="w-14 h-14 rounded-full border border-[var(--text-muted)] bg-[var(--accent-primary)]/10"></div>
    <div class="w-16 h-16 rounded-full border border-[var(--text-muted)] bg-[var(--text-primary)]/5"></div>
    <div class="w-12 h-12 rounded-full border border-[var(--text-muted)] bg-[var(--text-primary)]/5"></div>
  </div>
</div>

<script>
  import { setupBallPit } from '../lib/three/ballpit-controller';

  let cleanup: (() => void) | null = null;
  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    cleanup = setupBallPit();
  });
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = null;
  });
</script>

<style>
  @media (min-width: 1024px) and (pointer: fine) {
    .ball-pit-veil {
      -webkit-backdrop-filter: blur(2.5px);
      backdrop-filter: blur(2.5px);
    }
  }
</style>
