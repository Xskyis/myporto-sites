---
// Custom Cursor Component (Desktop Only) - Pinpoint Centered Accuracy
---

<!-- Outer trailing ring (smooth lerp lag) -->
<div
  id="cursor-ring"
  class="pointer-events-none fixed top-0 left-0 z-[100001] w-8 h-8 rounded-full border border-hairline opacity-0 transition-opacity duration-300 hidden md:block will-change-transform"
  style="border-color: var(--cursor-color);"
  aria-hidden="true"
></div>

<!-- Inner solid dot (instant, 100% pinpoint accuracy at mouse center) -->
<div
  id="cursor-dot"
  class="pointer-events-none fixed top-0 left-0 z-[100002] w-2 h-2 rounded-full opacity-0 transition-opacity duration-200 hidden md:block will-change-transform"
  style="background-color: var(--cursor-color);"
  aria-hidden="true"
></div>

<script>
  function setupCursor() {
    const isTouch = window.matchMedia('(pointer: coarse)').matches;
    const ring = document.getElementById('cursor-ring');
    const dot = document.getElementById('cursor-dot');

    if (isTouch || !ring || !dot) {
      document.documentElement.classList.remove('has-custom-cursor');
      return null;
    }

    // The native cursor is hidden by CSS only once this class exists, so a missing or
    // broken custom cursor can never leave desktop visitors without a pointer.
    document.documentElement.classList.add('has-custom-cursor');

    let mouseX = -100;
    let mouseY = -100;
    let ringX = -100;
    let ringY = -100;
    let isHovering = false;
    let isVisible = false;
    let isMouseDown = false;
    let isRunning = false;
    let animFrameId: number | null = null;

    const getScale = () => {
      if (isMouseDown) return isHovering ? 1.3 : 0.85;
      return isHovering ? 1.6 : 1;
    };

    const updateRing = () => {
      if (!isRunning) return;

      const dx = mouseX - ringX;
      const dy = mouseY - ringY;

      ringX += dx * 0.22;
      ringY += dy * 0.22;

      const scale = getScale();
      ring.style.transform = `translate3d(${ringX}px, ${ringY}px, 0) translate(-50%, -50%) scale(${scale})`;

      // Sleep loop when ring arrives at mouse target to eliminate idle CPU drain
      if (Math.abs(dx) < 0.08 && Math.abs(dy) < 0.08) {
        ringX = mouseX;
        ringY = mouseY;
        ring.style.transform = `translate3d(${ringX}px, ${ringY}px, 0) translate(-50%, -50%) scale(${scale})`;
        stopLoop();
        return;
      }

      animFrameId = requestAnimationFrame(updateRing);
    };

    const startLoop = () => {
      if (document.hidden) return;
      if (!isRunning) {
        isRunning = true;
        animFrameId = requestAnimationFrame(updateRing);
      }
    };

    const stopLoop = () => {
      isRunning = false;
      if (animFrameId !== null) {
        cancelAnimationFrame(animFrameId);
        animFrameId = null;
      }
    };

    const onPointerMove = (e: PointerEvent) => {
      mouseX = e.clientX;
      mouseY = e.clientY;

      // Pinpoint accuracy: maintain correct scale during hover so dot doesn't flicker
      const dotScale = isHovering ? 0.6 : 1;
      dot.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0) translate(-50%, -50%) scale(${dotScale})`;

      if (!isVisible) {
        ringX = mouseX;
        ringY = mouseY;
        ring.style.transform = `translate3d(${ringX}px, ${ringY}px, 0) translate(-50%, -50%) scale(${getScale()})`;
        dot.classList.remove('opacity-0');
        ring.classList.remove('opacity-0');
        dot.classList.add('opacity-100');
        ring.classList.add('opacity-100');
        isVisible = true;
      }

      startLoop();
    };

    const onMouseLeave = () => {
      dot.classList.add('opacity-0');
      ring.classList.add('opacity-0');
      dot.classList.remove('opacity-100');
      ring.classList.remove('opacity-100');
      isVisible = false;
      stopLoop();
    };

    const onMouseEnter = () => {
      dot.classList.remove('opacity-0');
      ring.classList.remove('opacity-0');
      dot.classList.add('opacity-100');
      ring.classList.add('opacity-100');
      isVisible = true;
      startLoop();
    };

    const onMouseDown = () => {
      isMouseDown = true;
      ring.style.transform = `translate3d(${ringX}px, ${ringY}px, 0) translate(-50%, -50%) scale(${getScale()})`;
    };

    const onMouseUp = () => {
      isMouseDown = false;
      ring.style.transform = `translate3d(${ringX}px, ${ringY}px, 0) translate(-50%, -50%) scale(${getScale()})`;
    };

    const onVisibilityChange = () => {
      if (document.hidden) {
        stopLoop();
      } else if (isVisible) {
        startLoop();
      }
    };

    // Interactive element hover detection
    const handleMouseOver = (e: MouseEvent) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;
      const interactive = target.closest('a, button, [role="button"], input, textarea, select, .project-card, .magnetic-btn');
      if (interactive) {
        isHovering = true;
        ring.style.backgroundColor = 'rgba(128, 128, 128, 0.12)';
        dot.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0) translate(-50%, -50%) scale(0.6)`;
        startLoop();
      }
    };

    const handleMouseOut = (e: MouseEvent) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;
      const interactive = target.closest('a, button, [role="button"], input, textarea, select, .project-card, .magnetic-btn');
      if (interactive) {
        isHovering = false;
        ring.style.backgroundColor = 'transparent';
        dot.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0) translate(-50%, -50%) scale(1)`;
        startLoop();
      }
    };

    window.addEventListener('pointermove', onPointerMove, { passive: true });
    document.addEventListener('mouseleave', onMouseLeave);
    document.addEventListener('mouseenter', onMouseEnter);
    document.addEventListener('mousedown', onMouseDown);
    document.addEventListener('mouseup', onMouseUp);
    document.addEventListener('visibilitychange', onVisibilityChange);
    document.addEventListener('mouseover', handleMouseOver);
    document.addEventListener('mouseout', handleMouseOut);

    return () => {
      window.removeEventListener('pointermove', onPointerMove);
      document.removeEventListener('mouseleave', onMouseLeave);
      document.removeEventListener('mouseenter', onMouseEnter);
      document.removeEventListener('mousedown', onMouseDown);
      document.removeEventListener('mouseup', onMouseUp);
      document.removeEventListener('visibilitychange', onVisibilityChange);
      document.removeEventListener('mouseover', handleMouseOver);
      document.removeEventListener('mouseout', handleMouseOut);
      stopLoop();
      document.documentElement.classList.remove('has-custom-cursor');
    };
  }

  let cleanup: (() => void) | null = null;

  function init() {
    if (cleanup) cleanup();
    cleanup = setupCursor();
  }

  init();
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    if (cleanup) {
      cleanup();
      cleanup = null;
    }
  });
</script>
