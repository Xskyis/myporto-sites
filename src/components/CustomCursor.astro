---
// Custom Cursor Component (Desktop Only) - Pinpoint Tip Accuracy
---

<!-- Single triangular pointer with its tip aligned to the real pointer position -->
<div
  id="cursor-ring"
  class="cursor-reticle pointer-events-none fixed top-0 left-0 z-[100001] opacity-0 transition-opacity duration-300 hidden md:block will-change-transform"
  aria-hidden="true"
></div>

<style>
  .cursor-reticle {
    width: 24px;
    height: 30px;
    color: var(--cursor-color);
    background: currentColor;
    clip-path: polygon(0 0, 0 100%, 100% 66%);
    transform-origin: 0 0;
    filter: drop-shadow(0 1px 2px color-mix(in srgb, var(--bg-primary) 70%, transparent));
  }
</style>

<script>
  import { setupCursor } from '../lib/cursor';

  let cleanup: (() => void) | null = null;

  function init() {
    cleanup?.();
    cleanup = setupCursor();
  }

  init();
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = null;
  });
</script>
