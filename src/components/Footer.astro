---
import { PROFILE } from "../data/profile";
import { SOCIALS } from "../data/socials";
import BallPit from "./BallPit.astro";
import { Icon } from "astro-icon/components";
---

<footer
  id="contact"
  class="relative w-full overflow-hidden border-t-hairline z-10 flex flex-col"
  aria-label="Footer and Contact"
>
  <!-- Interactive 3D Ball Pit Background with Soft Blur Overlay (Full Width) -->
  <BallPit />

  <!-- Main Contact Content (Foreground) -->
  <div
    class="relative z-20 w-full max-w-7xl mx-auto px-6 sm:px-8 md:px-12 lg:px-16 pt-16 md:pt-20 pb-16 md:pb-20 flex flex-col"
  >
    <!-- Section Header -->
    <div class="relative pb-6 sm:pb-8 text-xs font-mono text-[var(--text-muted)]">
      <div class="flex items-center justify-between" data-reveal>
        <div class="flex items-center gap-3">
          <span class="text-sm font-semibold text-[var(--text-primary)]">04</span>
        </div>
        <span>CONTACT</span>
      </div>
      <div class="hairline-sweep absolute bottom-0 left-0 right-0 h-[1px] bg-[var(--border-subtle)] origin-left" data-hairline-sweep aria-hidden="true"></div>
    </div>

    <!-- Giant Callout Headline -->
    <div class="pt-8 sm:pt-10 md:pt-12 pb-8 sm:pb-10 md:pb-12 max-w-4xl">
      <h2
        class="fluid-heading font-medium text-[var(--text-primary)] leading-[0.95]"
        data-reveal="words"
      >
        Let's engineer something memorable together.
      </h2>

      <p
        class="text-lg md:text-xl font-light text-[var(--text-muted)] mt-8 max-w-2xl leading-relaxed"
        data-reveal
      >
        Whether you have an ambitious digital product in need of precision
        frontend craftsmanship, or an open engineering role, my inbox is always
        open.
      </p>

      <!-- CTAs: Email, Copy Email, View CV & Download Link with Generous Tactile Padding -->
      <div class="mt-8 sm:mt-10 flex flex-wrap items-center gap-3.5 sm:gap-4" data-reveal>
        <!-- Main Email Button -->
        <a
          href={`mailto:${PROFILE.email}`}
          class="magnetic-btn group inline-flex items-center gap-2.5 px-6 sm:px-7 py-3.5 sm:py-4 min-h-[48px] sm:min-h-[52px] rounded-full bg-[var(--bg-surface)] border border-hairline text-[var(--text-primary)] hover:border-[var(--text-primary)] font-medium text-sm tracking-wide shadow-xs hover:shadow-md transition-colors duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--border-focus)]"
        >
          <Icon name="lucide:mail" class="w-4 h-4 text-[var(--text-muted)] group-hover:text-[var(--text-primary)] transition-colors shrink-0" aria-hidden="true" />
          <span>{PROFILE.email}</span>
          <Icon
            name="lucide:arrow-up-right"
            class="w-3.5 h-3.5 text-[var(--text-muted)] group-hover:text-[var(--text-primary)] transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 shrink-0"
            aria-hidden="true"
          />
        </a>

        <!-- Copy Email Button -->
        <button
          type="button"
          id="copy-email-btn"
          class="magnetic-btn group inline-flex items-center gap-2 px-5 sm:px-6 py-3.5 sm:py-4 min-h-[48px] sm:min-h-[52px] rounded-full border border-hairline bg-[var(--bg-surface)] text-[var(--text-primary)] hover:border-[var(--text-primary)] text-xs font-mono tracking-wider shadow-xs hover:shadow-md transition-colors duration-300 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--border-focus)]"
          aria-label="Copy email address to clipboard"
        >
          <Icon
            name="lucide:copy"
            class="w-3.5 h-3.5 text-[var(--text-muted)] group-hover:text-[var(--text-primary)] transition-colors shrink-0"
            id="copy-icon"
            aria-hidden="true"
          />
          <Icon
            name="lucide:check"
            class="w-3.5 h-3.5 text-[var(--status-dot)] hidden shrink-0"
            id="copy-check-icon"
            aria-hidden="true"
          />
          <span id="copy-text">Copy email</span>
        </button>

        <!-- Primary "View CV" Button -->
        <a
          href="/cv/CV_Achmad_Nabil_Afgareza_ATS.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="magnetic-btn group inline-flex items-center gap-2.5 px-7 sm:px-8 py-3.5 sm:py-4 min-h-[48px] sm:min-h-[52px] rounded-full bg-[var(--accent-primary)] text-[var(--accent-contrast)] font-medium text-sm tracking-wide shadow-lg hover:opacity-95 transition-opacity duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--border-focus)]"
        >
          <Icon name="lucide:file-text" class="w-4 h-4 shrink-0" aria-hidden="true" />
          <span>View CV</span>
          <Icon
            name="lucide:arrow-up-right"
            class="w-3.5 h-3.5 opacity-75 group-hover:opacity-100 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all shrink-0"
            aria-hidden="true"
          />
        </a>

        <!-- Secondary "Download" Button -->
        <a
          href="/cv/CV_Achmad_Nabil_Afgareza_ATS.pdf"
          download="CV_Achmad_Nabil_Afgareza_ATS.pdf"
          class="magnetic-btn group inline-flex items-center gap-2 px-5 sm:px-6 py-3.5 sm:py-4 min-h-[48px] sm:min-h-[52px] rounded-full border border-hairline bg-[var(--bg-surface)] text-[var(--text-primary)] hover:border-[var(--text-primary)] text-xs font-mono tracking-wider shadow-xs hover:shadow-md transition-colors duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--border-focus)]"
          title="Download curriculum vitae PDF directly"
        >
          <Icon
            name="lucide:download"
            class="w-3.5 h-3.5 text-[var(--text-muted)] group-hover:text-[var(--text-primary)] transition-transform duration-200 group-hover:translate-y-0.5 shrink-0"
            aria-hidden="true"
          />
          <span>Download PDF</span>
        </a>
      </div>
    </div>

    <!-- Bottom Links & Colophon (Protected with Clean Card) -->
    <div
      class="mt-8 md:mt-10 p-6 sm:p-8 rounded-2xl bg-[var(--bg-surface)] border border-hairline flex flex-col gap-6 shadow-xs"
      data-reveal
    >
      <div
        class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 text-xs font-mono text-[var(--text-muted)]"
      >
        <div class="flex flex-wrap items-center gap-2.5 sm:gap-3">
          {
            SOCIALS.map((soc) => (
              <a
                href={soc.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${soc.name}: ${soc.label}`}
                class="group inline-flex items-center gap-2 px-3.5 py-2 rounded-full border border-hairline bg-[var(--bg-surface-soft)]/50 text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-[var(--text-primary)] hover:bg-[var(--bg-surface-soft)] transition-colors duration-200 focus:outline-none focus-visible:ring-1 focus-visible:ring-[var(--border-focus)]"
              >
                <Icon name={soc.icon} class="w-3.5 h-3.5 text-[var(--text-primary)] shrink-0" aria-hidden="true" />
                <span class="hover-underline-anim">{soc.name}</span>
                <Icon
                  name="lucide:arrow-up-right"
                  class="w-3 h-3 opacity-60 group-hover:opacity-100 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 shrink-0"
                  aria-hidden="true"
                />
              </a>
            ))
          }
        </div>

        <!-- Back to top button -->
        <a
          href="#hero"
          id="back-to-top-btn"
          class="nav-scroll-trigger magnetic-btn group inline-flex items-center gap-2 px-4 py-2 rounded-full border border-hairline bg-[var(--bg-surface-soft)]/50 text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-[var(--text-primary)] transition-colors duration-200 focus:outline-none focus-visible:ring-1 focus-visible:ring-[var(--border-focus)]"
          aria-label="Back to top of page"
        >
          <span>BACK TO TOP</span>
          <Icon
            name="lucide:arrow-up"
            class="w-3.5 h-3.5 text-[var(--text-primary)] transition-transform duration-200 group-hover:-translate-y-0.5 shrink-0"
            aria-hidden="true"
          />
        </a>
      </div>

      <!-- Colophon / Copyright -->
      <div
        class="pt-4 border-t-hairline text-[11px] font-mono text-[var(--text-muted)]/80 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3"
      >
        <p>
          &copy; {new Date().getFullYear()}{' '}{PROFILE.name}. All rights reserved.
        </p>

        <div class="inline-flex items-center gap-1.5 text-[var(--text-muted)]/80">
          <Icon name="lucide:map-pin" class="w-3 h-3 opacity-75 shrink-0" aria-hidden="true" />
          <span>{PROFILE.location}</span>
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  import { PROFILE } from "../data/profile";

  let footerAbortController: AbortController | null = null;

  function setupFooter() {
    // One owner per page load: abort the previous listeners so repeated navigations
    // cannot stack duplicate clipboard handlers on the same button.
    footerAbortController?.abort();
    footerAbortController = new AbortController();
    const { signal } = footerAbortController;

    const copyBtn = document.getElementById("copy-email-btn");
    const copyText = document.getElementById("copy-text");
    const copyIcon = document.getElementById("copy-icon");
    const copyCheckIcon = document.getElementById("copy-check-icon");
    if (!copyBtn || !copyText) return;

    let resetTimer: number | undefined;

    copyBtn.addEventListener(
      "click",
      async () => {
        try {
          await navigator.clipboard.writeText(PROFILE.email);
          copyText.textContent = "Copied to clipboard!";
          copyIcon?.classList.add("hidden");
          copyCheckIcon?.classList.remove("hidden");
          copyBtn.classList.add(
            "border-[var(--status-dot)]",
            "text-[var(--status-dot)]",
          );

          window.clearTimeout(resetTimer);
          resetTimer = window.setTimeout(() => {
            copyText.textContent = "Copy email";
            copyIcon?.classList.remove("hidden");
            copyCheckIcon?.classList.add("hidden");
            copyBtn.classList.remove(
              "border-[var(--status-dot)]",
              "text-[var(--status-dot)]",
            );
          }, 2500);
        } catch (err) {
          console.warn("Clipboard write failed:", err);
        }
      },
      { signal },
    );
  }

  document.addEventListener("astro:page-load", setupFooter);
  document.addEventListener("astro:before-swap", () => {
    footerAbortController?.abort();
    footerAbortController = null;
  });
</script>
