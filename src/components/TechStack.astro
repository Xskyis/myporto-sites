---
import { TECH_STACK, TECH_CATEGORIES, type TechCategory, type TechLevel } from "../data/techstack";
import { Icon } from "astro-icon/components";

const groupedTech = TECH_CATEGORIES.map((cat) => ({
  category: cat,
  items: TECH_STACK.filter((t) => t.category === cat),
}));

const CATEGORY_SPAN_CLASSES: Record<TechCategory, string> = {
  Frontend: "sm:col-span-2 lg:col-span-8",
  Backend: "sm:col-span-1 lg:col-span-4",
  Database: "sm:col-span-1 lg:col-span-4",
  Mobile: "sm:col-span-1 lg:col-span-4",
  "Tools & Cloud": "sm:col-span-1 lg:col-span-4",
};

const LEVEL_DOT_CLASS: Record<TechLevel, string> = {
  "Daily use": "tech-dot--daily",
  Comfortable: "tech-dot--comfortable",
  Learning: "tech-dot--learning",
};
---

<section
  id="tech-stack"
  class="py-16 md:py-20 px-6 sm:px-8 md:px-12 lg:px-16 max-w-7xl mx-auto border-t-hairline z-10 relative"
  aria-labelledby="tech-stack-heading"
>
  <!-- Section Header -->
  <div class="relative pb-6 sm:pb-8 text-xs font-mono text-[var(--text-muted)]">
    <div class="flex items-center justify-between" data-reveal>
      <div class="flex items-center gap-3">
        <span class="text-sm font-semibold text-[var(--text-primary)]">03</span>
      </div>
      <span>TECHNICAL CAPABILITIES</span>
    </div>
    <div class="hairline-sweep absolute bottom-0 left-0 right-0 h-[1px] bg-[var(--border-subtle)] origin-left" data-hairline-sweep aria-hidden="true"></div>
  </div>

  <!-- Heading + Single Proficiency Legend -->
  <div
    class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pt-8 sm:pt-10 md:pt-12 pb-8 md:pb-10"
    data-reveal
  >
    <h2
      id="tech-stack-heading"
      class="fluid-subheading font-medium text-[var(--text-primary)]"
    >
      Technical Stack
    </h2>

    <!-- Legend -->
    <div
      class="flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-mono text-[var(--text-muted)]"
      aria-label="Proficiency level legend"
    >
      <span class="inline-flex items-center gap-2">
        <span class="tech-dot tech-dot--daily text-[var(--text-primary)]" aria-hidden="true"></span>
        <span>Daily use</span>
      </span>
      <span class="inline-flex items-center gap-2">
        <span class="tech-dot tech-dot--comfortable text-[var(--text-primary)]" aria-hidden="true"></span>
        <span>Comfortable</span>
      </span>
      <span class="inline-flex items-center gap-2">
        <span class="tech-dot tech-dot--learning text-[var(--text-primary)]" aria-hidden="true"></span>
        <span>Learning</span>
      </span>
    </div>
  </div>

  <!-- Compact Dense Category Grid -->
  <div
    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 grid-flow-row-dense gap-x-8 gap-y-8 md:gap-y-10"
    data-stagger-container
  >
    {
      groupedTech.map((group) => {
        const countLabel = String(group.items.length).padStart(2, "0");
        const spanClass = CATEGORY_SPAN_CLASSES[group.category];
        return (
          <div
            class={`${spanClass} border-t-hairline pt-5 md:pt-6 flex flex-col gap-4`}
            data-stagger-item
          >
            <div class="flex items-baseline justify-between gap-2">
              <h3 class="text-lg md:text-xl font-display font-medium text-[var(--text-primary)]">
                {group.category}
                <span class="ml-1.5 font-mono text-xs font-normal text-[var(--text-muted)]">
                  ({countLabel})
                </span>
              </h3>
            </div>

            <ul class="flex flex-wrap gap-2 sm:gap-2.5" role="list">
              {group.items.map((item) => {
                const dotClass = LEVEL_DOT_CLASS[item.level];
                const levelLower = item.level.toLowerCase();
                return (
                  <li>
                    <span
                      class="tech-chip inline-flex items-center gap-2 px-3.5 py-2 rounded-full border border-hairline bg-[var(--bg-surface)] text-[var(--text-primary)] hover:bg-[var(--text-primary)] hover:text-[var(--bg-primary)] hover:border-[var(--text-primary)] transition-colors duration-200 text-[13px] sm:text-sm font-medium select-none"
                      aria-label={`${item.name}, ${levelLower}`}
                      title={`${item.name} — ${item.level}`}
                    >
                      <Icon name={item.icon} class="w-4 h-4 text-current shrink-0" aria-hidden="true" />
                      <span>{item.name}</span>
                      <span class={`tech-dot ${dotClass} ml-0.5 shrink-0`} aria-hidden="true" />
                    </span>
                  </li>
                );
              })}
            </ul>
          </div>
        );
      })
    }
  </div>
</section>
