---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { getProjectCoverMeta } from '../data/project-assets';

const allProjects = await getCollection('projects');
const projects = allProjects
  .sort((a, b) => a.data.order - b.data.order)
  .map((project, idx) => {
    const { title, shortTitle, tagline, stackShort, year, cover, tags, subtitle } = project.data;
    const resolvedStack = (Array.isArray(stackShort) && stackShort.length > 0)
      ? stackShort.join(' / ')
      : (Array.isArray(tags) ? tags.slice(0, 3).join(' / ') : '');
    const resolvedTagline = tagline || subtitle || '';
    return {
      id: project.id,
      index: String(idx + 1).padStart(2, '0'),
      title,
      listTitle: shortTitle ?? title,
      tagline: resolvedTagline,
      stack: resolvedStack,
      year,
      cover,
      meta: getProjectCoverMeta(cover),
    };
  });
---

<section
  id="projects"
  class="py-16 md:py-20 px-6 sm:px-8 md:px-12 lg:px-16 max-w-7xl mx-auto border-t-hairline z-10 relative"
  aria-labelledby="projects-heading"
>
  <!-- Section Header -->
  <div class="relative pb-6 sm:pb-8 text-xs font-mono text-[var(--text-muted)]">
    <div class="flex items-center justify-between" data-reveal>
      <div class="flex items-center gap-3">
        <span class="text-sm font-semibold text-[var(--text-primary)]">02</span>
      </div>
      <span>SELECTED WORKS</span>
    </div>
    <div class="hairline-sweep absolute bottom-0 left-0 right-0 h-[1px] bg-[var(--border-subtle)] origin-left" data-hairline-sweep aria-hidden="true"></div>
  </div>

  <!-- Heading -->
  <h2
    id="projects-heading"
    class="fluid-subheading font-medium text-[var(--text-primary)] pt-8 sm:pt-10 md:pt-12 pb-8 md:pb-10"
    data-reveal
  >
    Selected Work
  </h2>

  <div class="lg:grid lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:gap-12 xl:gap-16">
    <!-- List column -->
    <div>
      <ul
        id="project-list"
        class="project-list border-y border-hairline divide-y divide-hairline"
        data-engaged="false"
        data-stagger-container
      >
        {projects.map((p, idx) => (
          <li data-stagger-item>
            <a
              href={`/projects/${p.id}`}
              class="project-row group relative flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-6 xl:gap-8 py-6 md:py-8 px-4 sm:px-6 focus:outline-none focus-visible:ring-1 focus-visible:ring-inset focus-visible:ring-[var(--border-focus)]"
              data-project-index={idx}
              data-project-id={p.id}
              data-project-number={p.index}
              data-project-title={p.listTitle}
              data-project-stack={p.stack}
              data-project-year={p.year}
              data-active={idx === 0 ? 'true' : 'false'}
              aria-label={`${p.title}, ${p.tagline}, ${p.year}`}
            >
              <!-- Thumbnail (below 1024px only; desktop uses the preview panel) -->
              <div
                class="lg:hidden shrink-0 w-28 sm:w-[120px] aspect-[1.96/1] rounded-md overflow-hidden border border-hairline bg-[var(--bg-surface-soft)]"
                aria-hidden="true"
              >
                {p.meta ? (
                  <picture>
                    <source srcset={p.meta.previewAvif} type="image/avif" />
                    <img
                      src={p.meta.previewWebp}
                      alt=""
                      width="160"
                      height="82"
                      loading={idx === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                      class="w-full h-full object-contain"
                    />
                  </picture>
                ) : p.cover ? (
                  <img src={p.cover} alt="" width="160" height="82" loading={idx === 0 ? 'eager' : 'lazy'} decoding="async" class="w-full h-full object-contain" />
                ) : (
                  <div class="w-full h-full flex items-center justify-center font-mono text-xs text-[var(--text-muted)]">{p.index}</div>
                )}
              </div>

              <!-- Index (sm and up) -->
              <span class="project-index hidden sm:block w-6 shrink-0 font-mono text-xs text-[var(--text-muted)]" aria-hidden="true">{p.index}</span>

              <!-- Title + descriptor -->
              <div class="flex-1 min-w-0 pr-4 sm:pr-6" aria-hidden="true">
                <span class="project-index sm:hidden block font-mono text-xs text-[var(--text-muted)] mb-1.5">{p.index}</span>
                <h3 class="project-title font-display font-medium text-[clamp(1.5rem,2.2vw,2.35rem)] leading-[1.08] tracking-tight text-[var(--text-primary)]">
                  {p.listTitle}
                </h3>
                <p class="mt-1.5 text-sm md:text-[15px] text-[var(--text-muted)]">{p.tagline}</p>
                <p class="md:hidden mt-2 font-mono text-xs text-[var(--text-muted)]">
                  <span class="text-[var(--text-primary)]">{p.year}</span>
                  <span class="mx-1">·</span>
                  <span>{p.stack}</span>
                </p>
              </div>

              <!-- Meta (md and up) -->
              <div class="hidden md:block shrink-0 text-right font-mono text-xs lg:text-[13px] leading-relaxed text-[var(--text-muted)] max-w-[220px] xl:max-w-none" aria-hidden="true">
                <div class="text-[var(--text-primary)]">{p.year}</div>
                <div>{p.stack}</div>
              </div>

              <!-- Arrow -->
              <span
                class="project-arrow absolute top-6 right-4 sm:static shrink-0 w-9 h-9 rounded-full border border-hairline flex items-center justify-center text-[var(--text-primary)]"
                aria-hidden="true"
              >
                <Icon name="lucide:arrow-right" class="project-arrow-icon w-4 h-4" />
              </span>
            </a>
          </li>
        ))}
      </ul>

      <div class="pt-6 px-4 sm:px-6 flex justify-end" data-reveal="fade">
        <a
          href="https://github.com/Xskyis?tab=repositories"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-2 py-1.5 px-3.5 rounded-full border border-hairline bg-[var(--bg-surface)] font-mono text-xs sm:text-[13px] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-[var(--text-primary)] transition-colors duration-200 focus:outline-none focus-visible:ring-1 focus-visible:ring-[var(--border-focus)]"
        >
          <Icon name="simple-icons:github" class="w-3.5 h-3.5 text-[var(--text-primary)] shrink-0" aria-hidden="true" />
          <span class="hover-underline-anim">More on GitHub</span>
          <Icon
            name="lucide:arrow-up-right"
            class="w-3.5 h-3.5 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            aria-hidden="true"
          />
        </a>
      </div>
    </div>

    <!-- Sticky preview panel (desktop only, decorative: the rows carry the same info) -->
    <div class="hidden lg:block" aria-hidden="true" data-reveal="scale">
      <div class="sticky top-28">
        <a
          id="preview-card-link"
          href={projects[0] ? `/projects/${projects[0].id}` : '#projects'}
          tabindex="-1"
          class="group/preview block rounded-2xl border border-hairline overflow-hidden bg-[var(--bg-surface)] shadow-sm transition-colors duration-300 hover:border-[var(--text-primary)]"
        >
          <!-- Editorial preview top bar -->
          <div class="px-4 py-2.5 border-b border-hairline bg-[var(--bg-surface-soft)]/60 flex items-center justify-between font-mono text-[11px] text-[var(--text-muted)]">
            <div class="flex items-center gap-2">
              <span class="inline-block w-1.5 h-1.5 rounded-full bg-[var(--accent-primary)]"></span>
              <span>
                <span id="preview-index" class="text-[var(--text-primary)] font-semibold">{projects[0]?.index ?? '01'}</span>
                <span class="opacity-50"> / {String(projects.length).padStart(2, '0')}</span>
              </span>
            </div>
            <span id="preview-year" class="uppercase tracking-wider">{projects[0]?.year ?? ''}</span>
          </div>

          <!-- Layered cover viewport -->
          <div class="relative aspect-[1.96/1] overflow-hidden bg-[var(--bg-surface-soft)]">
            {projects.map((p, idx) => (
              <div class="preview-layer absolute inset-0 bg-[var(--bg-surface-soft)]" data-preview-index={idx} data-active={idx === 0 ? 'true' : 'false'}>
                {p.meta ? (
                  <picture>
                    <source
                      type="image/avif"
                      srcset={`${p.meta.previewAvif} 640w, ${p.meta.avif} ${p.meta.width}w`}
                      sizes="(min-width: 1280px) 460px, 38vw"
                    />
                    <img
                      src={p.meta.previewWebp}
                      srcset={`${p.meta.previewWebp} 640w, ${p.cover} ${p.meta.width}w`}
                      sizes="(min-width: 1280px) 460px, 38vw"
                      alt=""
                      width="800"
                      height="408"
                      loading={idx === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                      class="w-full h-full object-contain"
                    />
                  </picture>
                ) : p.cover ? (
                  <img src={p.cover} alt="" width="800" height="408" loading={idx === 0 ? 'eager' : 'lazy'} decoding="async" class="w-full h-full object-contain" />
                ) : (
                  <div class="w-full h-full flex items-center justify-center font-display text-5xl text-[var(--text-muted)]">{p.index}</div>
                )}
              </div>
            ))}
          </div>

          <!-- Editorial preview caption footer -->
          <div class="px-4 py-3 border-t border-hairline bg-[var(--bg-surface)] flex items-center justify-between gap-4">
            <div class="min-w-0">
              <div id="preview-title" class="font-display font-medium text-sm text-[var(--text-primary)] truncate">
                {projects[0]?.listTitle ?? ''}
              </div>
              <div id="preview-stack" class="font-mono text-[11px] text-[var(--text-muted)] truncate mt-0.5">
                {projects[0]?.stack ?? ''}
              </div>
            </div>
            <span class="shrink-0 inline-flex items-center gap-1 font-mono text-[11px] uppercase tracking-wider text-[var(--text-primary)] group-hover/preview:text-[var(--accent-primary)] transition-colors">
              <span>Case study</span>
              <Icon name="lucide:arrow-up-right" class="w-3.5 h-3.5 transition-transform duration-200 group-hover/preview:translate-x-0.5 group-hover/preview:-translate-y-0.5" />
            </span>
          </div>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .project-row,
  .project-index,
  .project-title,
  .project-arrow,
  .project-arrow :global(svg) {
    transition:
      opacity 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease;
  }

  /* Always keep a subtle connection between the active row and the sticky preview panel */
  .project-row[data-active='true'] .project-index {
    color: var(--accent-primary);
    font-weight: 600;
  }

  .project-row[data-active='true'] .project-arrow {
    border-color: var(--text-primary);
  }

  .project-row[data-active='true'] .project-arrow :global(svg) {
    transform: rotate(-45deg);
  }

  /* Dim the rest and elevate the active row while the list is being explored (pointer or keyboard). */
  .project-list[data-engaged='true'] .project-row:not([data-active='true']) {
    opacity: 0.45;
  }

  .project-list[data-engaged='true'] .project-row[data-active='true'] {
    background-color: color-mix(in srgb, var(--bg-surface-soft) 60%, transparent);
  }

  .project-list[data-engaged='true'] .project-row[data-active='true'] .project-title {
    transform: translateX(7px);
  }

  .project-list[data-engaged='true'] .project-row[data-active='true'] .project-arrow {
    background-color: var(--accent-primary);
    border-color: var(--accent-primary);
    color: var(--accent-contrast);
  }

  .preview-layer {
    opacity: 0;
    transition: opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .preview-layer[data-active='true'] {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-row,
    .project-index,
    .project-title,
    .project-arrow,
    .project-arrow :global(svg),
    .preview-layer {
      transition: none;
    }

    .preview-layer,
    .project-list[data-engaged='true'] .project-row[data-active='true'] .project-title {
      transform: none;
    }
  }
</style>

<script>
  let cleanup: (() => void) | null = null;

  function setup(): (() => void) | null {
    const list = document.getElementById('project-list');
    if (!list) return null;

    const rows = Array.from(list.querySelectorAll<HTMLElement>('[data-project-index]'));
    const layers = Array.from(document.querySelectorAll<HTMLElement>('[data-preview-index]'));
    const previewLink = document.getElementById('preview-card-link') as HTMLAnchorElement | null;
    const previewIndex = document.getElementById('preview-index');
    const previewYear = document.getElementById('preview-year');
    const previewTitle = document.getElementById('preview-title');
    const previewStack = document.getElementById('preview-stack');
    if (rows.length === 0) return null;

    const abort = new AbortController();
    const { signal } = abort;

    let isPointerOverList = false;
    let scrollTriggers: Array<{ kill: () => void }> = [];

    const setActive = (index: number) => {
      rows.forEach((row, i) => row.setAttribute('data-active', String(i === index)));
      layers.forEach((layer, i) => layer.setAttribute('data-active', String(i === index)));

      const activeRow = rows[index];
      if (!activeRow) return;
      const id = activeRow.dataset.projectId;
      if (previewLink && id) previewLink.href = `/projects/${id}`;
      if (previewIndex) previewIndex.textContent = activeRow.dataset.projectNumber ?? '';
      if (previewYear) previewYear.textContent = activeRow.dataset.projectYear ?? '';
      if (previewTitle) previewTitle.textContent = activeRow.dataset.projectTitle ?? '';
      if (previewStack) previewStack.textContent = activeRow.dataset.projectStack ?? '';
    };

    const setEngaged = (engaged: boolean) => list.setAttribute('data-engaged', String(engaged));

    // Editorial Scroll Auto-Sync: On desktop, as user scrolls past projects,
    // the sticky preview transitions to whichever row crosses the optical reading line (52%),
    // giving an effortless magazine-scrub feel. Hovering always takes priority.
    const isDesktop = window.matchMedia('(min-width: 1024px)').matches;
    const isReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (isDesktop && !isReduced) {
      import('gsap/ScrollTrigger').then(({ ScrollTrigger }) => {
        if (signal.aborted) return;
        rows.forEach((row, i) => {
          const st = ScrollTrigger.create({
            trigger: row,
            start: 'top 52%',
            end: 'bottom 52%',
            onEnter: () => {
              if (!isPointerOverList) setActive(i);
            },
            onEnterBack: () => {
              if (!isPointerOverList) setActive(i);
            },
          });
          scrollTriggers.push(st);
        });
      });
    }

    rows.forEach((row, i) => {
      // Mouse/pen only: on touch a tap navigates straight to the detail page.
      row.addEventListener(
        'pointerenter',
        (e) => {
          if (e.pointerType === 'touch') return;
          isPointerOverList = true;
          setActive(i);
          setEngaged(true);
        },
        { signal }
      );
      row.addEventListener(
        'focus',
        () => {
          isPointerOverList = true;
          setActive(i);
          if (row.matches(':focus-visible')) setEngaged(true);
        },
        { signal }
      );
    });

    // Keep the last active project in the panel, but release the dimming.
    list.addEventListener(
      'pointerleave',
      () => {
        isPointerOverList = false;
        if (!list.querySelector(':focus-visible')) setEngaged(false);
      },
      { signal }
    );
    list.addEventListener(
      'focusout',
      (e) => {
        const next = e.relatedTarget as Node | null;
        if (!next || !list.contains(next)) {
          isPointerOverList = false;
          setEngaged(false);
        }
      },
      { signal }
    );

    return () => {
      abort.abort();
      scrollTriggers.forEach((st) => st.kill());
      scrollTriggers = [];
      setEngaged(false);
    };
  }

  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    cleanup = setup();
  });

  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = null;
  });
</script>
