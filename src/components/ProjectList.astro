---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { getProjectCoverMeta } from '../data/project-assets';

const allProjects = await getCollection('projects');
const projects = allProjects
  .sort((a, b) => a.data.order - b.data.order)
  .map((project, idx) => {
    const { title, shortTitle, tagline, stackShort, year, cover, tags, subtitle } = project.data;
    const resolvedStack = (Array.isArray(stackShort) && stackShort.length > 0)
      ? stackShort.join(' / ')
      : (Array.isArray(tags) ? tags.slice(0, 3).join(' / ') : '');
    const resolvedTagline = tagline || subtitle || '';
    return {
      id: project.id,
      index: String(idx + 1).padStart(2, '0'),
      title,
      listTitle: shortTitle ?? title,
      tagline: resolvedTagline,
      stack: resolvedStack,
      year,
      cover,
      meta: getProjectCoverMeta(cover),
    };
  });
---

<section
  id="projects"
  class="py-16 md:py-20 px-6 sm:px-8 md:px-12 lg:px-16 max-w-7xl mx-auto border-t-hairline z-10 relative"
  aria-labelledby="projects-heading"
>
  <!-- Section Header -->
  <div class="flex items-center justify-between pb-6 sm:pb-8 border-b-hairline text-xs font-mono text-[var(--text-muted)]" data-reveal>
    <div class="flex items-center gap-3">
      <span class="text-sm font-semibold text-[var(--text-primary)]">02</span>
    </div>
    <span>SELECTED WORKS</span>
  </div>

  <!-- Heading -->
  <h2
    id="projects-heading"
    class="fluid-subheading font-medium text-[var(--text-primary)] pt-8 sm:pt-10 md:pt-12 pb-8 md:pb-10"
    data-reveal
  >
    Selected Work
  </h2>

  <div class="lg:grid lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:gap-12 xl:gap-16">
    <!-- List column -->
    <div data-reveal>
      <ul id="project-list" class="project-list border-y border-hairline divide-y divide-hairline" data-engaged="false">
        {projects.map((p, idx) => (
          <li>
            <a
              href={`/projects/${p.id}`}
              class="project-row group relative flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-4 xl:gap-6 py-6 md:py-8 px-4 sm:px-6 focus:outline-none focus-visible:ring-1 focus-visible:ring-inset focus-visible:ring-[var(--border-focus)]"
              data-project-index={idx}
              data-active={idx === 0 ? 'true' : 'false'}
              aria-label={`${p.title}, ${p.tagline}, ${p.year}`}
            >
              <!-- Thumbnail (below 1024px only; desktop uses the preview panel) -->
              <div
                class="lg:hidden shrink-0 w-28 sm:w-[120px] aspect-[16/10] rounded-md overflow-hidden border border-hairline bg-[var(--bg-surface-soft)]"
                aria-hidden="true"
              >
                {p.meta ? (
                  <picture>
                    <source srcset={p.meta.previewAvif} type="image/avif" />
                    <img
                      src={p.meta.previewWebp}
                      alt=""
                      width="160"
                      height="100"
                      loading={idx === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                      class="w-full h-full object-cover"
                    />
                  </picture>
                ) : p.cover ? (
                  <img src={p.cover} alt="" width="160" height="100" loading={idx === 0 ? 'eager' : 'lazy'} decoding="async" class="w-full h-full object-cover" />
                ) : (
                  <div class="w-full h-full flex items-center justify-center font-mono text-xs text-[var(--text-muted)]">{p.index}</div>
                )}
              </div>

              <!-- Index (sm and up) -->
              <span class="hidden sm:block w-6 shrink-0 font-mono text-xs text-[var(--text-muted)]" aria-hidden="true">{p.index}</span>

              <!-- Title + descriptor -->
              <div class="flex-1 min-w-0 pr-2" aria-hidden="true">
                <span class="sm:hidden block font-mono text-xs text-[var(--text-muted)] mb-1.5">{p.index}</span>
                <h3 class="project-title font-display font-medium text-[clamp(1.5rem,2.2vw,2.35rem)] leading-[1.08] tracking-tight text-[var(--text-primary)]">
                  {p.listTitle}
                </h3>
                <p class="mt-1.5 text-sm md:text-[15px] text-[var(--text-muted)]">{p.tagline}</p>
                <p class="md:hidden mt-2 font-mono text-xs text-[var(--text-muted)]">
                  <span class="text-[var(--text-primary)]">{p.year}</span>
                  <span class="mx-1">·</span>
                  <span>{p.stack}</span>
                </p>
              </div>

              <!-- Meta (md and up) -->
              <div class="hidden md:block shrink-0 text-right font-mono text-xs lg:text-[13px] leading-relaxed text-[var(--text-muted)]" aria-hidden="true">
                <div class="text-[var(--text-primary)]">{p.year}</div>
                <div class="whitespace-nowrap">{p.stack}</div>
              </div>

              <!-- Arrow -->
              <span
                class="project-arrow absolute top-6 right-4 sm:static shrink-0 w-9 h-9 rounded-full border border-hairline flex items-center justify-center text-[var(--text-primary)]"
                aria-hidden="true"
              >
                <Icon name="lucide:arrow-right" class="project-arrow-icon w-4 h-4" />
              </span>
            </a>
          </li>
        ))}
      </ul>

      <div class="pt-6 px-4 md:px-8 flex justify-end">
        <a
          href="https://github.com/Xskyis?tab=repositories"
          target="_blank"
          rel="noopener noreferrer"
          class="hover-underline-anim inline-flex items-center gap-1.5 font-mono text-xs sm:text-[13px] text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors focus:outline-none focus-visible:ring-1 focus-visible:ring-[var(--border-focus)]"
        >
          <span>More on GitHub</span>
          <Icon name="lucide:arrow-up-right" class="w-3.5 h-3.5" aria-hidden="true" />
        </a>
      </div>
    </div>

    <!-- Sticky preview panel (desktop only, decorative: the rows carry the same info) -->
    <div class="hidden lg:block" aria-hidden="true">
      <div class="sticky top-28">
        <div class="relative aspect-[16/10] rounded-2xl border border-hairline overflow-hidden bg-[var(--bg-surface-soft)]">
          {projects.map((p, idx) => (
            <div class="preview-layer absolute inset-0" data-preview-index={idx} data-active={idx === 0 ? 'true' : 'false'}>
              {p.meta ? (
                <picture>
                  <source
                    type="image/avif"
                    srcset={`${p.meta.previewAvif} 640w, ${p.meta.avif} ${p.meta.width}w`}
                    sizes="(min-width: 1280px) 460px, 38vw"
                  />
                  <img
                    src={p.meta.previewWebp}
                    srcset={`${p.meta.previewWebp} 640w, ${p.cover} ${p.meta.width}w`}
                    sizes="(min-width: 1280px) 460px, 38vw"
                    alt=""
                    width="800"
                    height="500"
                    loading={idx === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                    class="w-full h-full object-cover object-top"
                  />
                </picture>
              ) : p.cover ? (
                <img src={p.cover} alt="" width="800" height="500" loading={idx === 0 ? 'eager' : 'lazy'} decoding="async" class="w-full h-full object-cover object-top" />
              ) : (
                <div class="w-full h-full flex items-center justify-center font-display text-5xl text-[var(--text-muted)]">{p.index}</div>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .project-row,
  .project-title,
  .project-arrow,
  .project-arrow :global(svg) {
    transition:
      opacity 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease;
  }

  /* Dim the rest only while the list is being explored (pointer or keyboard). */
  .project-list[data-engaged='true'] .project-row:not([data-active='true']) {
    opacity: 0.45;
  }

  .project-list[data-engaged='true'] .project-row[data-active='true'] .project-title {
    transform: translateX(7px);
  }

  .project-list[data-engaged='true'] .project-row[data-active='true'] .project-arrow {
    background-color: var(--accent-primary);
    border-color: var(--accent-primary);
    color: var(--accent-contrast);
  }

  .project-list[data-engaged='true'] .project-row[data-active='true'] .project-arrow :global(svg) {
    transform: rotate(-45deg);
  }

  .preview-layer {
    opacity: 0;
    transform: scale(1.035);
    transition:
      opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .preview-layer[data-active='true'] {
    opacity: 1;
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-row,
    .project-title,
    .project-arrow,
    .project-arrow :global(svg),
    .preview-layer {
      transition: none;
    }

    .preview-layer,
    .project-list[data-engaged='true'] .project-row[data-active='true'] .project-title {
      transform: none;
    }
  }
</style>

<script>
  let cleanup: (() => void) | null = null;

  function setup(): (() => void) | null {
    const list = document.getElementById('project-list');
    if (!list) return null;

    const rows = Array.from(list.querySelectorAll<HTMLElement>('[data-project-index]'));
    const layers = Array.from(document.querySelectorAll<HTMLElement>('[data-preview-index]'));
    if (rows.length === 0) return null;

    const abort = new AbortController();
    const { signal } = abort;

    const setActive = (index: number) => {
      rows.forEach((row, i) => row.setAttribute('data-active', String(i === index)));
      layers.forEach((layer, i) => layer.setAttribute('data-active', String(i === index)));
    };

    const setEngaged = (engaged: boolean) => list.setAttribute('data-engaged', String(engaged));

    rows.forEach((row, i) => {
      // Mouse/pen only: on touch a tap navigates straight to the detail page.
      row.addEventListener(
        'pointerenter',
        (e) => {
          if (e.pointerType === 'touch') return;
          setActive(i);
          setEngaged(true);
        },
        { signal }
      );
      row.addEventListener(
        'focus',
        () => {
          setActive(i);
          if (row.matches(':focus-visible')) setEngaged(true);
        },
        { signal }
      );
    });

    // Keep the last active project in the panel, but release the dimming.
    list.addEventListener('pointerleave', () => {
      if (!list.querySelector(':focus-visible')) setEngaged(false);
    }, { signal });
    list.addEventListener(
      'focusout',
      (e) => {
        const next = e.relatedTarget as Node | null;
        if (!next || !list.contains(next)) setEngaged(false);
      },
      { signal }
    );

    return () => {
      abort.abort();
      setEngaged(false);
    };
  }

  document.addEventListener('astro:page-load', () => {
    cleanup?.();
    cleanup = setup();
  });

  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = null;
  });
</script>
