---
import { PROFILE } from '../data/profile';
import { HONORS } from '../data/honors';
import { TIMELINE } from '../data/timeline';
import { CERTIFICATIONS, parseCertDateKey, type CertificationCategory } from '../data/certifications';
import { Icon } from 'astro-icon/components';

const CATEGORY_RELEVANCE: Record<CertificationCategory, number> = {
  web: 10,
  other: 20,
  cloud: 30,
  ai: 40,
};

const featuredCerts = CERTIFICATIONS.filter((cert) => cert.featured)
  .sort((a, b) => {
    const relA = a.relevance ?? CATEGORY_RELEVANCE[a.category ?? 'other'] ?? 50;
    const relB = b.relevance ?? CATEGORY_RELEVANCE[b.category ?? 'other'] ?? 50;
    if (relA !== relB) return relA - relB;
    return parseCertDateKey(b.issueDate) - parseCertDateKey(a.issueDate);
  })
  .slice(0, 8);

const allCertsSorted = [...CERTIFICATIONS].sort(
  (a, b) => parseCertDateKey(b.issueDate) - parseCertDateKey(a.issueDate)
);

const totalCertsCount = CERTIFICATIONS.length;

const filterCategories: { id: 'all' | CertificationCategory; label: string; count: number }[] = [
  { id: 'all', label: 'All', count: totalCertsCount },
  { id: 'web', label: 'Web', count: CERTIFICATIONS.filter((c) => (c.category ?? 'other') === 'web').length },
  { id: 'cloud', label: 'Cloud', count: CERTIFICATIONS.filter((c) => (c.category ?? 'other') === 'cloud').length },
  { id: 'ai', label: 'AI', count: CERTIFICATIONS.filter((c) => (c.category ?? 'other') === 'ai').length },
  { id: 'other', label: 'Other', count: CERTIFICATIONS.filter((c) => (c.category ?? 'other') === 'other').length },
];

function resolveCertUrl(url?: string): string {
  if (url && !url.includes('TODO')) return url;
  return url || 'https://www.linkedin.com/in/nabilfgrza/details/certifications/';
}
---

<section id="about" class="py-16 md:py-20 px-6 sm:px-8 md:px-12 lg:px-16 max-w-7xl mx-auto border-t-hairline z-10 relative" aria-label="About Section">
  <!-- Section Header -->
  <div class="relative pb-6 sm:pb-8 text-xs font-mono text-[var(--text-muted)]">
    <div class="flex items-center justify-between" data-reveal>
      <div class="flex items-center gap-3">
        <span class="text-sm font-semibold text-[var(--text-primary)]">01</span>
      </div>
      <span>ABOUT &amp; TRAJECTORY</span>
    </div>
    <div class="hairline-sweep absolute bottom-0 left-0 right-0 h-[1px] bg-[var(--border-subtle)] origin-left" data-hairline-sweep aria-hidden="true"></div>
  </div>

  <!-- Top Grid: Bio & Animated Counters -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 pt-8 sm:pt-10 md:pt-12 pb-10 sm:pb-12 md:pb-14 items-start">
    <div class="lg:col-span-4">
      <h2 class="fluid-subheading font-medium text-[var(--text-primary)] sticky top-28 leading-tight" data-reveal="words">
        Driven by curiosity, refined by hands-on execution.
      </h2>
    </div>

    <div class="lg:col-span-8 flex flex-col gap-10">
      <!-- Bio paragraphs with kinetic reading illumination -->
      <div class="space-y-6 text-base md:text-xl font-light text-[var(--text-muted)] leading-relaxed" data-reading-illuminate>
        {PROFILE.bio.map((paragraph) => (
          <p class="last:text-[var(--text-primary)] last:font-normal">{paragraph}</p>
        ))}
      </div>

      <!-- Animated Stat Counters -->
      <div class="relative pt-6">
        <div class="hairline-sweep absolute top-0 left-0 right-0 h-[1px] bg-[var(--border-subtle)] origin-left" data-hairline-sweep aria-hidden="true"></div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6" data-stagger-container>
          {PROFILE.stats.map((stat) => (
          <div class="p-6 rounded-xl border border-hairline bg-[var(--bg-surface)] flex flex-col justify-between" data-stagger-item>
            <div>
              <div class="text-4xl md:text-5xl font-display font-bold text-[var(--text-primary)] tracking-tight">
                <span data-counter-target={stat.value}>0</span>
                <span>{stat.suffix}</span>
              </div>
              <div class="text-xs font-mono uppercase tracking-wider text-[var(--text-primary)] font-medium mt-2">
                {stat.label}
              </div>
            </div>
            <p class="text-xs text-[var(--text-muted)] mt-4 leading-normal">
              {stat.description}
            </p>
          </div>
        ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Honors & Awards (Editorial Vertical Spotlight) -->
  {HONORS.length > 0 && (
    <div class="my-8 md:my-12" id="honors-block" data-reveal>
      <div class="pb-6 sm:pb-8">
        <span class="text-xs font-mono uppercase tracking-widest text-[var(--text-muted)]">Recognition</span>
        <h3 class="text-2xl md:text-3xl font-display font-medium text-[var(--text-primary)] mt-1">
          Honors &amp; Awards
        </h3>
      </div>

      <div class="border-y border-hairline divide-y divide-hairline">
        {HONORS.map((honor, idx) => {
          const isActive = idx === 0;
          const indexLabel = String(idx + 1).padStart(2, '0');
          return (
            <article
              id={`honor-panel-${idx}`}
              role="button"
              tabindex="0"
              aria-expanded={isActive ? 'true' : 'false'}
              data-honor-row={idx}
              data-active={isActive ? 'true' : 'false'}
              class="honor-row group relative py-6 md:py-8 px-4 sm:px-6 md:px-8 cursor-pointer focus:outline-none focus-visible:ring-1 focus-visible:ring-[var(--border-focus)]"
            >
              <div class="honor-row-shift">
                <!-- Row Header: Index + Inline Trophy + Display Title + Ghost Year Numeral -->
                <div class="flex items-baseline justify-between gap-4">
                  <div class="flex items-baseline gap-3 sm:gap-4 min-w-0">
                    <span class="honor-index inline-flex items-center gap-1.5 text-xs sm:text-[13px] font-mono tracking-wider shrink-0 transition-colors duration-300">
                      <span>{indexLabel}</span>
                      <Icon name="lucide:trophy" class="w-3.5 h-3.5" aria-hidden="true" />
                    </span>
                    <h4 class="text-xl sm:text-2xl md:text-3xl font-display font-semibold text-[var(--text-primary)] tracking-tight leading-snug">
                      {honor.title}
                    </h4>
                  </div>

                  <span
                    class="honor-ghost-year hidden sm:block font-display text-3xl md:text-5xl font-bold leading-none tracking-tighter select-none pointer-events-none shrink-0"
                    aria-hidden="true"
                  >
                    {honor.year}
                  </span>
                </div>

                <!-- Expandable Meta & Description -->
                <div
                  class="honor-details-grid"
                  aria-hidden={isActive ? 'false' : 'true'}
                  inert={!isActive || undefined}
                >
                  <div class="overflow-hidden">
                    <div class="honor-details-inner pl-0 sm:pl-11 md:pl-12 pt-3 md:pt-4">
                      <p class="text-xs sm:text-[13px] font-mono text-[var(--text-primary)] leading-relaxed">
                        <span>{honor.org}</span>
                        <span class="mx-1.5 text-[var(--text-muted)]" aria-hidden="true">·</span>
                        <span>{honor.category}</span>
                        <span class="mx-1.5 text-[var(--text-muted)]" aria-hidden="true">·</span>
                        <span>{honor.month} {honor.year}</span>
                        <span class="mx-1.5 text-[var(--text-muted)]" aria-hidden="true">·</span>
                        <span>{honor.location}</span>
                      </p>
                      <p class="text-[15px] md:text-base text-[var(--text-muted)] leading-relaxed mt-2 max-w-2xl">
                        {honor.description}
                      </p>
                      {honor.link && (
                        <a
                          href={honor.link}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="mt-3 inline-flex items-center gap-1.5 text-xs font-mono text-[var(--accent-primary)] hover:underline focus:outline-none focus-visible:ring-1 focus-visible:ring-[var(--border-focus)]"
                        >
                          <span>View Recognition</span>
                          <Icon name="lucide:arrow-up-right" class="w-3.5 h-3.5" aria-hidden="true" />
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  )}

  <!-- Timeline Section -->
  <div class="pt-10 md:pt-12 pb-10 md:pb-12" id="timeline-container">
    <div class="pb-6 sm:pb-8" data-reveal>
      <span class="text-xs font-mono uppercase tracking-widest text-[var(--text-muted)]">Journey</span>
      <h3 class="text-2xl md:text-3xl font-display font-medium text-[var(--text-primary)] mt-1">
        Experience &amp; Education
      </h3>
    </div>

    <!-- Timeline items with scroll-driven line -->
    <div class="relative border-l border-hairline">
      <!-- Animated vertical progress line overlay -->
      <div id="timeline-progress-line" class="absolute left-[-1px] top-0 w-[2px] h-full bg-[var(--accent-primary)] origin-top" style="transform: scaleY(0);" aria-hidden="true"></div>

      {TIMELINE.map((item) => (
        <div class="relative group pl-6 sm:pl-8 md:pl-12 pr-4 sm:pr-8 md:pr-12 lg:pr-16 py-10 md:py-12 hover:bg-[var(--bg-surface-soft)]/50 transition-all duration-300" data-reveal>
          <!-- Node Dot -->
          <div class="timeline-node-dot absolute -left-[7px] top-[41px] md:top-[49px] w-3.5 h-3.5 rounded-full border-2 border-[var(--bg-primary)] bg-[var(--text-muted)] group-hover:bg-[var(--accent-primary)] transition-all duration-300 will-change-transform"></div>

          <div class="flex flex-col md:flex-row md:items-baseline justify-between gap-2">
            <div>
              <span class="text-xs font-mono uppercase tracking-wider text-[var(--text-muted)]">
                {item.organization} · {item.location}
              </span>
              <h4 class="text-xl md:text-2xl font-display font-semibold text-[var(--text-primary)] mt-0.5">
                {item.role}
              </h4>
            </div>
            <div class="text-xs font-mono font-medium text-[var(--text-muted)] shrink-0">
              {item.period}
            </div>
          </div>

          <p class="text-sm md:text-base text-[var(--text-muted)] font-light leading-relaxed mt-3 max-w-3xl">
            {item.description}
          </p>

          <!-- Skills tags -->
          <div class="flex flex-wrap gap-2 mt-4">
            {item.skills.map((skill) => (
              <span class="text-xs font-mono px-2.5 py-1 rounded-md border border-hairline bg-[var(--bg-surface)] text-[var(--text-muted)]">
                {skill}
              </span>
            ))}

            {item.certificatePlaceholder && (
              <a
                href={item.certificateUrl}
                class="text-xs font-mono px-2.5 py-1 rounded-md border border-hairline border-dashed bg-[var(--bg-surface-soft)] text-[var(--accent-primary)] hover:underline inline-flex items-center gap-1.5"
                title="Internship Certificate Placeholder"
              >
                <Icon name="lucide:file-text" class="w-3 h-3" />
                <span>Internship Certificate</span>
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Certifications & Languages Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 pt-10 md:pt-12 border-t-hairline items-start">
    <!-- Certifications (Curated Editorial List) -->
    <div class="lg:col-span-8" data-reveal>
      <div class="pb-6">
        <span class="text-xs font-mono uppercase tracking-widest text-[var(--text-muted)]">Verified Credentials</span>
        <h3 class="text-2xl md:text-3xl font-display font-medium text-[var(--text-primary)] mt-1">
          Certificates
        </h3>
      </div>

      <div class="certs-curated-list border-y border-hairline divide-y divide-hairline">
        {featuredCerts.map((cert, idx) => {
          const indexLabel = String(idx + 1).padStart(2, '0');
          return (
            <div class="cert-curated-row py-4 sm:py-5 px-4 sm:px-6 md:px-8 flex flex-col sm:flex-row sm:items-center justify-between gap-2 sm:gap-6">
              <div class="flex items-baseline gap-3 sm:gap-4 min-w-0">
                <span class="text-xs sm:text-[13px] font-mono text-[var(--text-muted)] shrink-0">
                  {indexLabel}
                </span>
                <div class="min-w-0">
                  <h4 class="cert-curated-title text-sm sm:text-base font-medium text-[var(--text-primary)] leading-snug">
                    {cert.title}
                  </h4>
                  <p class="text-xs sm:text-[13px] text-[var(--text-muted)] mt-0.5 leading-relaxed">
                    <span>{cert.issuer}</span>
                    <span class="mx-1.5" aria-hidden="true">·</span>
                    <span>{cert.issueDate}</span>
                  </p>
                </div>
              </div>

              <a
                href={resolveCertUrl(cert.credentialUrl)}
                target="_blank"
                rel="noopener noreferrer"
                class="pl-7 sm:pl-0 shrink-0 self-start sm:self-center inline-flex items-center gap-1 text-xs sm:text-[13px] font-mono text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors duration-200 focus:outline-none focus-visible:ring-1 focus-visible:ring-[var(--border-focus)]"
                aria-label={`Credential for ${cert.title}`}
              >
                <span class="hover-underline-anim">Credential</span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          );
        })}
      </div>

      <!-- View all button -->
      <div class="pt-6">
        <button
          type="button"
          id="open-certs-modal-btn"
          aria-haspopup="dialog"
          aria-controls="certs-dialog"
          class="magnetic-btn group inline-flex items-center gap-2.5 px-5 py-2.5 rounded-full border border-hairline bg-[var(--bg-surface)] text-xs sm:text-[13px] font-mono font-medium text-[var(--text-primary)] hover:border-[var(--text-primary)] hover:bg-[var(--bg-surface-soft)] shadow-xs hover:shadow-md transition-colors duration-200 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--border-focus)]"
        >
          <Icon name="lucide:award" class="w-4 h-4 text-[var(--accent-primary)] shrink-0" aria-hidden="true" />
          <span class="hover-underline-anim">View all {totalCertsCount} certificates</span>
          <Icon
            name="lucide:arrow-up-right"
            class="w-3.5 h-3.5 text-[var(--text-muted)] group-hover:text-[var(--text-primary)] transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 shrink-0"
            aria-hidden="true"
          />
        </button>
      </div>
    </div>

    <!-- Languages -->
    <div class="lg:col-span-4" data-reveal>
      <div class="pb-6">
        <span class="text-xs font-mono uppercase tracking-widest text-[var(--text-muted)]">Communication</span>
        <h3 class="text-2xl md:text-3xl font-display font-medium text-[var(--text-primary)] mt-1">
          Languages
        </h3>
      </div>

      <div class="space-y-4">
        {PROFILE.languages.map((lang) => (
          <div class="p-4 rounded-xl border border-hairline bg-[var(--bg-surface)]">
            <div class="flex justify-between items-center text-sm font-semibold text-[var(--text-primary)]">
              <span>{lang.name}</span>
              <span class="text-xs font-mono font-normal text-[var(--text-muted)]">{lang.nativeName}</span>
            </div>
            <p class="text-xs text-[var(--text-muted)] mt-1">{lang.proficiency}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- All Certificates Modal (<dialog>) -->
  <dialog
    id="certs-dialog"
    aria-labelledby="certs-dialog-title"
    aria-modal="true"
    class="certs-dialog fixed inset-0 z-[9990] w-screen h-dvh max-w-none max-h-none m-0 p-0 bg-transparent text-[var(--text-primary)] overflow-hidden"
    data-lenis-prevent
  >
    <div
      id="certs-dialog-backdrop"
      class="w-full h-full flex flex-col justify-end sm:items-center sm:justify-center sm:px-6 sm:py-12 md:py-16"
    >
      <div class="certs-dialog-panel w-full sm:w-[min(90vw,54rem)] max-h-[82dvh] sm:max-h-[75vh] flex flex-col bg-[var(--bg-primary)] text-[var(--text-primary)] border-t sm:border border-hairline rounded-t-2xl sm:rounded-2xl shadow-2xl overflow-hidden">
        <!-- Sticky Dialog Header & Filter Bar -->
        <div class="px-5 sm:px-8 pt-5 sm:pt-7 pb-4 border-b border-hairline bg-[var(--bg-primary)] shrink-0">
          <div class="flex items-center justify-between gap-4">
            <h3 id="certs-dialog-title" class="text-xl sm:text-2xl font-display font-medium text-[var(--text-primary)]">
              All certificates <span class="font-mono text-sm sm:text-base font-normal text-[var(--text-muted)]">({totalCertsCount})</span>
            </h3>

            <button
              type="button"
              id="close-certs-modal-btn"
              class="w-9 h-9 rounded-full border border-hairline bg-[var(--bg-surface)] flex items-center justify-center text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-[var(--text-primary)] transition-colors duration-200 focus:outline-none focus-visible:ring-1 focus-visible:ring-[var(--border-focus)]"
              aria-label="Close certificates dialog"
            >
              <Icon name="lucide:x" class="w-4 h-4" aria-hidden="true" />
            </button>
          </div>

          <!-- Instant Category Filter Chips -->
          <div class="flex flex-wrap items-center gap-2 mt-4" role="group" aria-label="Filter certificates by category">
            {filterCategories.map((cat, idx) => {
              const isDefault = idx === 0;
              return (
                <button
                  type="button"
                  data-cert-filter={cat.id}
                  aria-pressed={isDefault ? 'true' : 'false'}
                  class={`cert-filter-chip inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-mono border transition-colors duration-200 focus:outline-none focus-visible:ring-1 focus-visible:ring-[var(--border-focus)] ${
                    isDefault
                      ? 'bg-[var(--text-primary)] text-[var(--bg-primary)] border-[var(--text-primary)] font-medium'
                      : 'bg-[var(--bg-surface)] text-[var(--text-muted)] border-hairline hover:text-[var(--text-primary)] hover:border-[var(--text-primary)]'
                  }`}
                >
                  <span>{cat.label}</span>
                  <span class="opacity-70">({cat.count})</span>
                </button>
              );
            })}
          </div>
        </div>

        <!-- Scrollable 2-Column Certificate List -->
        <div
          class="certs-dialog-scroll px-5 sm:px-8 py-4 sm:py-6 overflow-y-auto overscroll-contain flex-1"
          data-lenis-prevent
        >
          <div id="certs-dialog-grid" class="grid grid-cols-1 md:grid-cols-2 gap-x-8">
            {allCertsSorted.map((cert) => (
              <div
                data-cert-item
                data-cert-category={cert.category ?? 'other'}
                class="p-3 sm:p-3.5 rounded-xl hover:bg-[var(--bg-surface-soft)]/50 transition-colors duration-200 flex items-start justify-between gap-4"
              >
                <div class="min-w-0">
                  <h4 class="text-sm sm:text-[15px] font-medium text-[var(--text-primary)] leading-snug">
                    {cert.title}
                  </h4>
                  <p class="text-xs text-[var(--text-muted)] mt-1 leading-relaxed">
                    <span>{cert.issuer}</span>
                    <span class="mx-1.5" aria-hidden="true">·</span>
                    <span>{cert.issueDate}</span>
                  </p>
                </div>

                <a
                  href={resolveCertUrl(cert.credentialUrl)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="shrink-0 inline-flex items-center gap-1 text-xs font-mono text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors duration-200 pt-0.5 focus:outline-none focus-visible:ring-1 focus-visible:ring-[var(--border-focus)]"
                  aria-label={`Credential for ${cert.title}`}
                >
                  <span class="hover-underline-anim">Credential</span>
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </dialog>
</section>

<script>
  import { scrollLock } from '../lib/scroll/scroll-lock';

  let certsModalCleanup: (() => void) | null = null;
  let honorsCleanup: (() => void) | null = null;

  function setupCertsModal(): (() => void) | null {
    const dialog = document.getElementById('certs-dialog') as HTMLDialogElement | null;
    const openBtn = document.getElementById('open-certs-modal-btn') as HTMLButtonElement | null;
    const closeBtn = document.getElementById('close-certs-modal-btn') as HTMLButtonElement | null;
    if (!dialog || !openBtn || !closeBtn) return null;

    const abort = new AbortController();
    const { signal } = abort;

    // Move dialog to document.body so it escapes <main class="z-10"> and <section class="z-10">,
    // sitting cleanly above #main-header (z-50) while remaining below CustomCursor (z-[100001]).
    const originalParent = dialog.parentElement;
    if (dialog.parentElement !== document.body) {
      document.body.appendChild(dialog);
    }

    const backdrop = document.getElementById('certs-dialog-backdrop');
    const filterBtns = Array.from(dialog.querySelectorAll<HTMLButtonElement>('[data-cert-filter]'));
    const certItems = Array.from(dialog.querySelectorAll<HTMLElement>('[data-cert-item]'));
    const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

    let closeTimer: number | null = null;
    let isClosing = false;

    const lockScroll = () => {
      document.documentElement.classList.add('certs-modal-open');
      scrollLock.acquire('certs');
    };

    const unlockScroll = () => {
      document.documentElement.classList.remove('certs-modal-open');
      scrollLock.release('certs');
    };

    const applyFilter = (category: string) => {
      filterBtns.forEach((btn) => {
        const isActive = btn.getAttribute('data-cert-filter') === category;
        btn.setAttribute('aria-pressed', String(isActive));
        if (isActive) {
          btn.classList.add(
            'bg-[var(--text-primary)]',
            'text-[var(--bg-primary)]',
            'border-[var(--text-primary)]',
            'font-medium'
          );
          btn.classList.remove(
            'bg-[var(--bg-surface)]',
            'text-[var(--text-muted)]',
            'border-hairline'
          );
        } else {
          btn.classList.remove(
            'bg-[var(--text-primary)]',
            'text-[var(--bg-primary)]',
            'border-[var(--text-primary)]',
            'font-medium'
          );
          btn.classList.add(
            'bg-[var(--bg-surface)]',
            'text-[var(--text-muted)]',
            'border-hairline'
          );
        }
      });

      certItems.forEach((item) => {
        const itemCat = item.getAttribute('data-cert-category') || 'other';
        const matches = category === 'all' || itemCat === category;
        if (matches) {
          item.removeAttribute('hidden');
          item.classList.add('flex');
          item.classList.remove('hidden');
        } else {
          item.setAttribute('hidden', '');
          item.classList.add('hidden');
          item.classList.remove('flex');
        }
      });
    };

    const openModal = () => {
      if (dialog.open) return;
      if (closeTimer !== null) {
        window.clearTimeout(closeTimer);
        closeTimer = null;
      }
      isClosing = false;
      dialog.removeAttribute('data-closing');
      // Use dialog.show() instead of showModal() so the modal stays in the standard
      // stacking context (z-[9990]) rather than the browser's #top-layer, allowing the
      // custom cursor (z-[100001]+) to remain visible above the dialog.
      dialog.show();
      lockScroll();
      closeBtn.focus();
    };

    const finishClose = (restoreFocus: boolean) => {
      if (closeTimer !== null) {
        window.clearTimeout(closeTimer);
        closeTimer = null;
      }
      isClosing = false;
      dialog.removeAttribute('data-closing');
      if (dialog.open) {
        dialog.close();
      }
      unlockScroll();
      if (restoreFocus) {
        openBtn.focus();
      }
    };

    const closeModal = (restoreFocus = true) => {
      if (!dialog.open || isClosing) return;
      if (reducedMotionQuery.matches) {
        finishClose(restoreFocus);
        return;
      }
      isClosing = true;
      dialog.setAttribute('data-closing', 'true');
      closeTimer = window.setTimeout(() => {
        finishClose(restoreFocus);
      }, 280);
    };

    openBtn.addEventListener('click', () => openModal(), { signal });
    closeBtn.addEventListener('click', () => closeModal(true), { signal });

    // Click on backdrop to close
    dialog.addEventListener(
      'click',
      (e: MouseEvent) => {
        if (e.target === dialog || e.target === backdrop) {
          closeModal(true);
        }
      },
      { signal }
    );

    // ESC key cancel handling
    dialog.addEventListener(
      'cancel',
      (e: Event) => {
        e.preventDefault();
        closeModal(true);
      },
      { signal }
    );

    // Global keydown for Escape and Tab focus trap while dialog is open
    window.addEventListener(
      'keydown',
      (e: KeyboardEvent) => {
        if (!dialog.open) return;

        if (e.key === 'Escape') {
          e.preventDefault();
          closeModal(true);
          return;
        }
        if (e.key !== 'Tab') return;

        const focusables = Array.from(
          dialog.querySelectorAll<HTMLElement>(
            'button:not([disabled]), a[href], [tabindex]:not([tabindex="-1"])'
          )
        ).filter((el) => !el.closest('[hidden]') && el.offsetParent !== null);

        if (focusables.length === 0) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];

        if (e.shiftKey && (document.activeElement === first || !dialog.contains(document.activeElement))) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && (document.activeElement === last || !dialog.contains(document.activeElement))) {
          e.preventDefault();
          first.focus();
        }
      },
      { signal }
    );

    // Filter chip clicks
    filterBtns.forEach((btn) => {
      btn.addEventListener(
        'click',
        () => {
          const category = btn.getAttribute('data-cert-filter') || 'all';
          applyFilter(category);
        },
        { signal }
      );
    });

    return () => {
      if (closeTimer !== null) {
        window.clearTimeout(closeTimer);
        closeTimer = null;
      }
      if (dialog.open) {
        dialog.close();
      }
      dialog.removeAttribute('data-closing');
      if (originalParent && dialog.parentElement === document.body) {
        originalParent.appendChild(dialog);
      }
      unlockScroll();
      abort.abort();
    };
  }

  function setupHonorsSpotlight(): (() => void) | null {
    const block = document.getElementById('honors-block');
    if (!block) return null;

    const rows = Array.from(block.querySelectorAll<HTMLElement>('[data-honor-row]'));
    if (rows.length === 0) return null;

    const abort = new AbortController();
    const { signal } = abort;
    const total = rows.length;
    const AUTO_ADVANCE_MS = 4500;

    const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    let isReducedMotion = reducedMotionQuery.matches;

    let activeIndex = 0;
    let remainingMs = AUTO_ADVANCE_MS;
    let timerStartedAt: number | null = null;
    let timerId: number | null = null;

    let isInView = false;
    let isHovered = false;
    let isFocusedWithin = false;

    const updateActiveState = () => {
      rows.forEach((row, idx) => {
        const isActive = idx === activeIndex;
        row.setAttribute('data-active', String(isActive));
        row.setAttribute('aria-expanded', String(isReducedMotion ? true : isActive));
        const details = row.querySelector<HTMLElement>('.honor-details-grid');
        if (!details) return;

        if (isReducedMotion) {
          details.setAttribute('aria-hidden', 'false');
          details.removeAttribute('inert');
        } else {
          details.setAttribute('aria-hidden', String(!isActive));
          if (isActive) {
            details.removeAttribute('inert');
          } else {
            details.setAttribute('inert', '');
          }
        }
      });
    };

    const canRunTimer = () =>
      !isReducedMotion &&
      total > 1 &&
      isInView &&
      !document.hidden &&
      !isHovered &&
      !isFocusedWithin;

    const stopTimerLoop = () => {
      if (timerId !== null) {
        window.clearTimeout(timerId);
        timerId = null;
      }
      if (timerStartedAt !== null) {
        const elapsed = performance.now() - timerStartedAt;
        remainingMs = Math.max(100, remainingMs - elapsed);
        timerStartedAt = null;
      }
    };

    const syncTimerLoop = () => {
      if (canRunTimer()) {
        if (timerId === null) {
          timerStartedAt = performance.now();
          timerId = window.setTimeout(() => {
            timerId = null;
            timerStartedAt = null;
            remainingMs = AUTO_ADVANCE_MS;
            activeIndex = (activeIndex + 1) % total;
            updateActiveState();
            syncTimerLoop();
          }, remainingMs);
        }
      } else {
        stopTimerLoop();
      }
    };

    const selectHonor = (nextIdx: number, focusRow = false) => {
      const normalized = ((nextIdx % total) + total) % total;
      activeIndex = normalized;
      if (timerId !== null) {
        window.clearTimeout(timerId);
        timerId = null;
      }
      timerStartedAt = null;
      remainingMs = AUTO_ADVANCE_MS;
      updateActiveState();
      if (focusRow) {
        rows[normalized]?.focus();
      }
      syncTimerLoop();
    };

    // Click/tap and keyboard interaction on rows
    rows.forEach((row, idx) => {
      row.addEventListener(
        'click',
        (e: MouseEvent) => {
          const target = e.target as HTMLElement | null;
          if (target?.closest('a, button')) return;
          selectHonor(idx, false);
        },
        { signal }
      );

      row.addEventListener(
        'keydown',
        (e: KeyboardEvent) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            selectHonor(idx, false);
          } else if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
            e.preventDefault();
            selectHonor(activeIndex + 1, true);
          } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
            e.preventDefault();
            selectHonor(activeIndex - 1, true);
          }
        },
        { signal }
      );
    });

    // Hover pause (desktop fine pointer)
    block.addEventListener(
      'pointerenter',
      (e: PointerEvent) => {
        if (e.pointerType === 'mouse') {
          isHovered = true;
          syncTimerLoop();
        }
      },
      { signal }
    );

    block.addEventListener(
      'pointerleave',
      (e: PointerEvent) => {
        if (e.pointerType === 'mouse') {
          isHovered = false;
          syncTimerLoop();
        }
      },
      { signal }
    );

    // Keyboard focus pause within the block
    block.addEventListener(
      'focusin',
      () => {
        isFocusedWithin = true;
        syncTimerLoop();
      },
      { signal }
    );

    block.addEventListener(
      'focusout',
      (e: FocusEvent) => {
        const nextFocused = e.relatedTarget as Node | null;
        if (!nextFocused || !block.contains(nextFocused)) {
          isFocusedWithin = false;
          syncTimerLoop();
        }
      },
      { signal }
    );

    // Tab visibility pause
    document.addEventListener(
      'visibilitychange',
      () => {
        syncTimerLoop();
      },
      { signal }
    );

    // Reduced-motion dynamic change listener
    reducedMotionQuery.addEventListener(
      'change',
      (e) => {
        isReducedMotion = e.matches;
        if (isReducedMotion) {
          remainingMs = AUTO_ADVANCE_MS;
        }
        updateActiveState();
        syncTimerLoop();
      },
      { signal }
    );

    // IntersectionObserver: only run timer while Honors block is visible in viewport
    const io = new IntersectionObserver(
      ([entry]) => {
        isInView = entry.isIntersecting;
        syncTimerLoop();
      },
      { threshold: 0.25 }
    );
    io.observe(block);

    updateActiveState();
    syncTimerLoop();

    return () => {
      stopTimerLoop();
      io.disconnect();
      abort.abort();
    };
  }

  document.addEventListener('astro:page-load', () => {
    certsModalCleanup?.();
    certsModalCleanup = setupCertsModal();
    honorsCleanup?.();
    honorsCleanup = setupHonorsSpotlight();
  });

  document.addEventListener('astro:before-swap', () => {
    if (certsModalCleanup) {
      certsModalCleanup();
      certsModalCleanup = null;
    }
    if (honorsCleanup) {
      honorsCleanup();
      honorsCleanup = null;
    }
  });
</script>
