---
import { PROFILE } from '../data/profile';
import { HONORS } from '../data/honors';
import { TIMELINE } from '../data/timeline';
import { CERTIFICATIONS } from '../data/certifications';
import { Icon } from 'astro-icon/components';

const PAGE_SIZE = 5;
const certPages: (typeof CERTIFICATIONS)[] = [];
for (let i = 0; i < CERTIFICATIONS.length; i += PAGE_SIZE) {
  certPages.push(CERTIFICATIONS.slice(i, i + PAGE_SIZE));
}
const totalCertPages = certPages.length;
---

<section id="about" class="pt-12 sm:pt-14 md:pt-16 pb-16 md:pb-20 px-6 sm:px-8 md:px-12 lg:px-16 max-w-7xl mx-auto z-10 relative" aria-label="About Section">
  <!-- Section Header -->
  <div class="flex items-center justify-between pb-6 sm:pb-8 border-b-hairline text-xs font-mono text-[var(--text-muted)]" data-reveal>
    <div class="flex items-center gap-3">
      <span class="text-sm font-semibold text-[var(--text-primary)]">01</span>
    </div>
    <span>ABOUT &amp; TRAJECTORY</span>
  </div>

  <!-- Top Grid: Bio & Animated Counters -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 pt-8 sm:pt-10 md:pt-12 pb-10 sm:pb-12 md:pb-14 items-start">
    <div class="lg:col-span-4">
      <h2 class="fluid-subheading font-medium text-[var(--text-primary)] sticky top-28 leading-tight" data-reveal="words">
        Driven by curiosity, refined by hands-on execution.
      </h2>
    </div>

    <div class="lg:col-span-8 flex flex-col gap-10">
      <!-- Bio paragraphs -->
      <div class="space-y-6 text-base md:text-xl font-light text-[var(--text-muted)] leading-relaxed" data-reveal>
        {PROFILE.bio.map((paragraph) => (
          <p class="last:text-[var(--text-primary)] last:font-normal">{paragraph}</p>
        ))}
      </div>

      <!-- Animated Stat Counters -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-6 border-t-hairline" data-stagger-container>
        {PROFILE.stats.map((stat) => (
          <div class="p-6 rounded-xl border border-hairline bg-[var(--bg-surface)] flex flex-col justify-between" data-stagger-item>
            <div>
              <div class="text-4xl md:text-5xl font-display font-bold text-[var(--text-primary)] tracking-tight">
                <span data-counter-target={stat.value}>0</span>
                <span>{stat.suffix}</span>
              </div>
              <div class="text-xs font-mono uppercase tracking-wider text-[var(--text-primary)] font-medium mt-2">
                {stat.label}
              </div>
            </div>
            <p class="text-xs text-[var(--text-muted)] mt-4 leading-normal">
              {stat.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Honors & Awards (Editorial Vertical Spotlight) -->
  {HONORS.length > 0 && (
    <div class="my-8 md:my-12" id="honors-block" data-reveal>
      <div class="pb-6 sm:pb-8">
        <span class="text-xs font-mono uppercase tracking-widest text-[var(--text-muted)]">Recognition</span>
        <h3 class="text-2xl md:text-3xl font-display font-medium text-[var(--text-primary)] mt-1">
          Honors &amp; Awards
        </h3>
      </div>

      <div class="border-y border-hairline divide-y divide-hairline">
        {HONORS.map((honor, idx) => {
          const isActive = idx === 0;
          const indexLabel = String(idx + 1).padStart(2, '0');
          return (
            <article
              id={`honor-panel-${idx}`}
              role="button"
              tabindex="0"
              aria-expanded={isActive ? 'true' : 'false'}
              data-honor-row={idx}
              data-active={isActive ? 'true' : 'false'}
              class="honor-row group relative py-6 md:py-8 px-4 sm:px-6 md:px-8 cursor-pointer focus:outline-none focus-visible:ring-1 focus-visible:ring-[var(--border-focus)]"
            >
              <div class="honor-row-shift">
                <!-- Row Header: Index + Inline Trophy + Display Title + Ghost Year Numeral -->
                <div class="flex items-baseline justify-between gap-4">
                  <div class="flex items-baseline gap-3 sm:gap-4 min-w-0">
                    <span class="honor-index inline-flex items-center gap-1.5 text-xs sm:text-[13px] font-mono tracking-wider shrink-0 transition-colors duration-300">
                      <span>{indexLabel}</span>
                      <Icon name="lucide:trophy" class="w-3.5 h-3.5" aria-hidden="true" />
                    </span>
                    <h4 class="text-xl sm:text-2xl md:text-3xl font-display font-semibold text-[var(--text-primary)] tracking-tight leading-snug">
                      {honor.title}
                    </h4>
                  </div>

                  <span
                    class="honor-ghost-year hidden sm:block font-display text-3xl md:text-5xl font-bold leading-none tracking-tighter select-none pointer-events-none shrink-0"
                    aria-hidden="true"
                  >
                    {honor.year}
                  </span>
                </div>

                <!-- Expandable Meta & Description -->
                <div
                  class="honor-details-grid"
                  aria-hidden={isActive ? 'false' : 'true'}
                  inert={!isActive || undefined}
                >
                  <div class="overflow-hidden">
                    <div class="honor-details-inner pl-0 sm:pl-11 md:pl-12 pt-3 md:pt-4">
                      <p class="text-xs sm:text-[13px] font-mono text-[var(--text-primary)] leading-relaxed">
                        <span>{honor.org}</span>
                        <span class="mx-1.5 text-[var(--text-muted)]" aria-hidden="true">·</span>
                        <span>{honor.category}</span>
                        <span class="mx-1.5 text-[var(--text-muted)]" aria-hidden="true">·</span>
                        <span>{honor.month} {honor.year}</span>
                        <span class="mx-1.5 text-[var(--text-muted)]" aria-hidden="true">·</span>
                        <span>{honor.location}</span>
                      </p>
                      <p class="text-[15px] md:text-base text-[var(--text-muted)] leading-relaxed mt-2 max-w-2xl">
                        {honor.description}
                      </p>
                      {honor.link && (
                        <a
                          href={honor.link}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="mt-3 inline-flex items-center gap-1.5 text-xs font-mono text-[var(--accent-primary)] hover:underline focus:outline-none focus-visible:ring-1 focus-visible:ring-[var(--border-focus)]"
                        >
                          <span>View Recognition</span>
                          <Icon name="lucide:arrow-up-right" class="w-3.5 h-3.5" aria-hidden="true" />
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  )}

  <!-- Timeline Section -->
  <div class="pt-10 md:pt-12 pb-10 md:pb-12" id="timeline-container">
    <div class="pb-6 sm:pb-8" data-reveal>
      <span class="text-xs font-mono uppercase tracking-widest text-[var(--text-muted)]">Journey</span>
      <h3 class="text-2xl md:text-3xl font-display font-medium text-[var(--text-primary)] mt-1">
        Experience &amp; Education
      </h3>
    </div>

    <!-- Timeline items with scroll-driven line -->
    <div class="relative border-l border-hairline">
      <!-- Animated vertical progress line overlay -->
      <div id="timeline-progress-line" class="absolute left-[-1px] top-0 w-[2px] h-full bg-[var(--accent-primary)] origin-top scale-y-0" aria-hidden="true"></div>

      {TIMELINE.map((item) => (
        <div class="relative group pl-6 sm:pl-8 md:pl-12 pr-4 sm:pr-8 md:pr-12 lg:pr-16 py-10 md:py-12 hover:bg-[var(--bg-surface-soft)]/50 transition-all duration-300" data-reveal>
          <!-- Node Dot -->
          <div class="timeline-node-dot absolute -left-[7px] top-[41px] md:top-[49px] w-3.5 h-3.5 rounded-full border-2 border-[var(--bg-primary)] bg-[var(--text-muted)] group-hover:bg-[var(--accent-primary)] transition-all duration-300 will-change-transform"></div>

          <div class="flex flex-col md:flex-row md:items-baseline justify-between gap-2">
            <div>
              <span class="text-xs font-mono uppercase tracking-wider text-[var(--text-muted)]">
                {item.organization} · {item.location}
              </span>
              <h4 class="text-xl md:text-2xl font-display font-semibold text-[var(--text-primary)] mt-0.5">
                {item.role}
              </h4>
            </div>
            <div class="text-xs font-mono font-medium text-[var(--text-muted)] shrink-0">
              {item.period}
            </div>
          </div>

          <p class="text-sm md:text-base text-[var(--text-muted)] font-light leading-relaxed mt-3 max-w-3xl">
            {item.description}
          </p>

          <!-- Skills tags -->
          <div class="flex flex-wrap gap-2 mt-4">
            {item.skills.map((skill) => (
              <span class="text-xs font-mono px-2.5 py-1 rounded-md border border-hairline bg-[var(--bg-surface)] text-[var(--text-muted)]">
                {skill}
              </span>
            ))}

            {item.certificatePlaceholder && (
              <a
                href={item.certificateUrl}
                class="text-xs font-mono px-2.5 py-1 rounded-md border border-hairline border-dashed bg-[var(--bg-surface-soft)] text-[var(--accent-primary)] hover:underline inline-flex items-center gap-1.5"
                title="Internship Certificate Placeholder"
              >
                <Icon name="lucide:file-text" class="w-3 h-3" />
                <span>Internship Certificate</span>
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Certifications & Languages Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 pt-10 md:pt-12 border-t-hairline">
    <!-- Certifications (Horizontal Paginated Slider) -->
    <div class="lg:col-span-8 flex flex-col justify-between" data-reveal>
      <div>
        <div class="pb-6 flex items-center justify-between gap-4 flex-wrap">
          <div>
            <span class="text-xs font-mono uppercase tracking-widest text-[var(--text-muted)]">Verified Credentials</span>
            <h3 class="text-2xl font-display font-medium text-[var(--text-primary)] mt-1">
              Certificates &amp; Skill Badges ({CERTIFICATIONS.length})
            </h3>
          </div>

          <!-- Top Navigation Controls -->
          <div class="flex items-center gap-3">
            <span class="text-xs font-mono text-[var(--text-muted)] tracking-wider">
              PAGE <span id="cert-page-current" class="text-[var(--text-primary)] font-semibold">01</span> / {String(totalCertPages).padStart(2, '0')}
            </span>
            <div class="flex items-center gap-1.5">
              <button
                type="button"
                id="cert-prev-btn"
                class="cert-prev-btn w-8 h-8 rounded-full border border-hairline bg-[var(--bg-surface)] flex items-center justify-center text-[var(--text-primary)] hover:border-[var(--text-primary)] transition-all disabled:opacity-30 disabled:pointer-events-none focus:outline-none focus-visible:ring-1 focus-visible:ring-[var(--border-focus)] shadow-xs"
                aria-label="Previous page of certificates"
                disabled
              >
                <Icon name="lucide:arrow-left" class="w-3.5 h-3.5" />
              </button>
              <button
                type="button"
                id="cert-next-btn"
                class="cert-next-btn w-8 h-8 rounded-full border border-hairline bg-[var(--bg-surface)] flex items-center justify-center text-[var(--text-primary)] hover:border-[var(--text-primary)] transition-all disabled:opacity-30 disabled:pointer-events-none focus:outline-none focus-visible:ring-1 focus-visible:ring-[var(--border-focus)] shadow-xs"
                aria-label="Next page of certificates"
              >
                <Icon name="lucide:arrow-right" class="w-3.5 h-3.5" />
              </button>
            </div>
          </div>
        </div>

        <!-- Horizontal Slide Viewport & Track -->
        <div
          id="certs-viewport"
          class="relative overflow-hidden w-full border-y border-hairline"
          aria-label="Certificates list paginated"
        >
          <div
            id="certs-track"
            class="flex w-full will-change-transform transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]"
            style="transform: translateX(0%);"
          >
            {certPages.map((page, pageIdx) => (
              <div
                class="w-full shrink-0 divide-y divide-hairline min-h-[385px]"
                data-cert-page={pageIdx}
                aria-hidden={pageIdx !== 0}
                inert={pageIdx !== 0 || undefined}
              >
                {page.map((cert, itemIdx) => {
                  const globalIdx = pageIdx * PAGE_SIZE + itemIdx;
                  return (
                    <div
                      class="py-4 sm:py-5 px-3 sm:px-6 md:px-8 cert-item hover:bg-[var(--bg-surface-soft)]/50 transition-all duration-300"
                    >
                      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div class="flex items-start gap-3">
                          <span class="text-xs font-mono text-[var(--text-muted)] pt-0.5">
                            {String(globalIdx + 1).padStart(2, '0')}
                          </span>
                          <div>
                            <h4 class="text-sm sm:text-base font-semibold text-[var(--text-primary)] line-clamp-1">
                              {cert.title}
                            </h4>
                            <p class="text-xs text-[var(--text-muted)] mt-0.5">
                              {cert.issuer} · Issued {cert.issueDate} {cert.expiryDate ? `(Valid until ${cert.expiryDate})` : ''}
                            </p>
                          </div>
                        </div>

                        <a
                          href={cert.credentialUrl && !cert.credentialUrl.includes('TODO') ? cert.credentialUrl : (cert.credentialUrl || 'https://www.linkedin.com/in/nabilfgrza/details/certifications/')}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="shrink-0 self-start sm:self-center inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full border border-hairline bg-[var(--bg-surface)] hover:bg-[var(--accent-primary)] hover:text-[var(--accent-contrast)] hover:border-[var(--accent-primary)] text-xs font-mono text-[var(--text-primary)] transition-all duration-200 group/cert-btn focus:outline-none focus-visible:ring-1 focus-visible:ring-[var(--border-focus)] shadow-xs"
                          aria-label={`View certificate for ${cert.title}`}
                        >
                          <span>Credential</span>
                          <Icon name="lucide:arrow-up-right" class="w-3.5 h-3.5 opacity-60 group-hover/cert-btn:opacity-100 group-hover/cert-btn:translate-x-0.5 group-hover/cert-btn:-translate-y-0.5 transition-transform duration-200" />
                        </a>
                      </div>
                    </div>
                  );
                })}
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Bottom Pagination Controls (Indicator & Numeric Pills) -->
      <div class="pt-6 flex flex-wrap items-center justify-between gap-4 text-xs font-mono">
        <span id="cert-page-range" class="text-[var(--text-muted)]">
          Showing 01–05 of {CERTIFICATIONS.length} credentials
        </span>

        <!-- Page Pills -->
        <div class="flex items-center gap-1.5" role="navigation" aria-label="Certificate Pages">
          {certPages.map((_, pIdx) => (
            <button
              type="button"
              class={`cert-page-pill w-7 h-7 sm:w-8 sm:h-8 rounded-lg flex items-center justify-center font-mono text-xs border transition-all duration-200 focus:outline-none focus-visible:ring-1 focus-visible:ring-[var(--border-focus)] ${pIdx === 0 ? 'bg-[var(--accent-primary)] text-[var(--accent-contrast)] border-[var(--accent-primary)] font-semibold shadow-xs' : 'border-hairline bg-[var(--bg-surface)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-[var(--text-primary)]'}`}
              data-page-index={pIdx}
              aria-label={`Go to page ${pIdx + 1}`}
              aria-current={pIdx === 0 ? 'page' : undefined}
            >
              {String(pIdx + 1).padStart(2, '0')}
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- Languages & Direct Links -->
    <div class="lg:col-span-4 flex flex-col justify-between gap-8" data-reveal>
      <div>
        <span class="text-xs font-mono uppercase tracking-widest text-[var(--text-muted)]">Communication</span>
        <h3 class="text-2xl font-display font-medium text-[var(--text-primary)] mt-1 mb-6">
          Languages
        </h3>

        <div class="space-y-4">
          {PROFILE.languages.map((lang) => (
            <div class="p-4 rounded-xl border border-hairline bg-[var(--bg-surface)]">
              <div class="flex justify-between items-center text-sm font-semibold text-[var(--text-primary)]">
                <span>{lang.name}</span>
                <span class="text-xs font-mono font-normal text-[var(--text-muted)]">{lang.nativeName}</span>
              </div>
              <p class="text-xs text-[var(--text-muted)] mt-1">{lang.proficiency}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  let certsAbortController: AbortController | null = null;
  let honorsCleanup: (() => void) | null = null;

  function setupCertsPagination() {
    if (certsAbortController) {
      certsAbortController.abort();
    }
    certsAbortController = new AbortController();
    const { signal } = certsAbortController;

    const track = document.getElementById('certs-track');
    const prevBtns = document.querySelectorAll<HTMLButtonElement>('.cert-prev-btn');
    const nextBtns = document.querySelectorAll<HTMLButtonElement>('.cert-next-btn');
    const pagePills = document.querySelectorAll<HTMLButtonElement>('.cert-page-pill');
    const pageCurrent = document.getElementById('cert-page-current');
    const pageRange = document.getElementById('cert-page-range');
    const pageElements = document.querySelectorAll<HTMLElement>('[data-cert-page]');

    if (!track || pageElements.length === 0) return;

    const totalPages = pageElements.length;
    const totalItems = track.querySelectorAll('.cert-item').length;
    const pageSize = 5;
    let currentPage = 0;

    const updateUI = () => {
      track.style.transform = `translateX(-${currentPage * 100}%)`;

      if (pageCurrent) {
        pageCurrent.textContent = String(currentPage + 1).padStart(2, '0');
      }

      if (pageRange) {
        const start = currentPage * pageSize + 1;
        const end = Math.min((currentPage + 1) * pageSize, totalItems);
        pageRange.textContent = `Showing ${String(start).padStart(2, '0')}–${String(end).padStart(2, '0')} of ${totalItems} credentials`;
      }

      prevBtns.forEach((btn) => {
        btn.disabled = currentPage === 0;
      });
      nextBtns.forEach((btn) => {
        btn.disabled = currentPage === totalPages - 1;
      });

      pagePills.forEach((pill, idx) => {
        const isCurrent = idx === currentPage;
        if (isCurrent) {
          pill.setAttribute('aria-current', 'page');
          pill.classList.add(
            'bg-[var(--accent-primary)]',
            'text-[var(--accent-contrast)]',
            'border-[var(--accent-primary)]',
            'font-semibold',
            'shadow-xs'
          );
          pill.classList.remove(
            'border-hairline',
            'bg-[var(--bg-surface)]',
            'text-[var(--text-muted)]'
          );
        } else {
          pill.removeAttribute('aria-current');
          pill.classList.remove(
            'bg-[var(--accent-primary)]',
            'text-[var(--accent-contrast)]',
            'border-[var(--accent-primary)]',
            'font-semibold',
            'shadow-xs'
          );
          pill.classList.add(
            'border-hairline',
            'bg-[var(--bg-surface)]',
            'text-[var(--text-muted)]'
          );
        }
      });

      pageElements.forEach((el, idx) => {
        const isHidden = idx !== currentPage;
        el.setAttribute('aria-hidden', String(isHidden));
        if (isHidden) {
          el.setAttribute('inert', '');
        } else {
          el.removeAttribute('inert');
        }
      });
    };

    const goToPage = (page: number) => {
      if (page < 0 || page >= totalPages) return;
      currentPage = page;
      updateUI();
    };

    prevBtns.forEach((btn) => {
      btn.addEventListener('click', () => goToPage(currentPage - 1), { signal });
    });
    nextBtns.forEach((btn) => {
      btn.addEventListener('click', () => goToPage(currentPage + 1), { signal });
    });

    pagePills.forEach((pill) => {
      pill.addEventListener(
        'click',
        () => {
          const pIdx = parseInt(pill.getAttribute('data-page-index') || '0', 10);
          goToPage(pIdx);
        },
        { signal }
      );
    });

    let touchStartX = 0;
    let touchStartY = 0;
    track.addEventListener(
      'touchstart',
      (e: TouchEvent) => {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
      },
      { passive: true, signal }
    );

    track.addEventListener(
      'touchend',
      (e: TouchEvent) => {
        const touchEndX = e.changedTouches[0].clientX;
        const touchEndY = e.changedTouches[0].clientY;
        const dx = touchEndX - touchStartX;
        const dy = touchEndY - touchStartY;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
          if (dx < 0) {
            goToPage(currentPage + 1);
          } else {
            goToPage(currentPage - 1);
          }
        }
      },
      { passive: true, signal }
    );

    updateUI();
  }

  function setupHonorsSpotlight(): (() => void) | null {
    const block = document.getElementById('honors-block');
    if (!block) return null;

    const rows = Array.from(block.querySelectorAll<HTMLElement>('[data-honor-row]'));
    if (rows.length === 0) return null;

    const abort = new AbortController();
    const { signal } = abort;
    const total = rows.length;
    const AUTO_ADVANCE_MS = 4500;

    const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    let isReducedMotion = reducedMotionQuery.matches;

    let activeIndex = 0;
    let elapsedMs = 0;
    let lastTickTime: number | null = null;
    let rafId: number | null = null;

    let isInView = false;
    let isHovered = false;
    let isFocusedWithin = false;

    const updateActiveState = () => {
      rows.forEach((row, idx) => {
        const isActive = idx === activeIndex;
        row.setAttribute('data-active', String(isActive));
        row.setAttribute('aria-expanded', String(isReducedMotion ? true : isActive));
        const details = row.querySelector<HTMLElement>('.honor-details-grid');
        if (!details) return;

        if (isReducedMotion) {
          details.setAttribute('aria-hidden', 'false');
          details.removeAttribute('inert');
        } else {
          details.setAttribute('aria-hidden', String(!isActive));
          if (isActive) {
            details.removeAttribute('inert');
          } else {
            details.setAttribute('inert', '');
          }
        }
      });
    };

    const canRunTimer = () =>
      !isReducedMotion &&
      total > 1 &&
      isInView &&
      !document.hidden &&
      !isHovered &&
      !isFocusedWithin;

    const stopTimerLoop = () => {
      if (rafId !== null) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
      lastTickTime = null;
    };

    const tick = (now: number) => {
      if (!canRunTimer()) {
        stopTimerLoop();
        return;
      }

      if (lastTickTime === null) {
        lastTickTime = now;
      }
      const delta = Math.min(now - lastTickTime, 100);
      lastTickTime = now;
      elapsedMs += delta;

      if (elapsedMs >= AUTO_ADVANCE_MS) {
        elapsedMs = 0;
        activeIndex = (activeIndex + 1) % total;
        updateActiveState();
      }

      rafId = requestAnimationFrame(tick);
    };

    const syncTimerLoop = () => {
      if (canRunTimer()) {
        if (rafId === null) {
          lastTickTime = null;
          rafId = requestAnimationFrame(tick);
        }
      } else {
        stopTimerLoop();
      }
    };

    const selectHonor = (nextIdx: number, focusRow = false) => {
      const normalized = ((nextIdx % total) + total) % total;
      activeIndex = normalized;
      elapsedMs = 0;
      updateActiveState();
      if (focusRow) {
        rows[normalized]?.focus();
      }
      syncTimerLoop();
    };

    // Click/tap and keyboard interaction on rows
    rows.forEach((row, idx) => {
      row.addEventListener(
        'click',
        (e: MouseEvent) => {
          const target = e.target as HTMLElement | null;
          if (target?.closest('a, button')) return;
          selectHonor(idx, false);
        },
        { signal }
      );

      row.addEventListener(
        'keydown',
        (e: KeyboardEvent) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            selectHonor(idx, false);
          } else if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
            e.preventDefault();
            selectHonor(activeIndex + 1, true);
          } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
            e.preventDefault();
            selectHonor(activeIndex - 1, true);
          }
        },
        { signal }
      );
    });

    // Hover pause (desktop fine pointer)
    block.addEventListener(
      'pointerenter',
      (e: PointerEvent) => {
        if (e.pointerType === 'mouse') {
          isHovered = true;
          syncTimerLoop();
        }
      },
      { signal }
    );

    block.addEventListener(
      'pointerleave',
      (e: PointerEvent) => {
        if (e.pointerType === 'mouse') {
          isHovered = false;
          syncTimerLoop();
        }
      },
      { signal }
    );

    // Keyboard focus pause within the block
    block.addEventListener(
      'focusin',
      () => {
        isFocusedWithin = true;
        syncTimerLoop();
      },
      { signal }
    );

    block.addEventListener(
      'focusout',
      (e: FocusEvent) => {
        const nextFocused = e.relatedTarget as Node | null;
        if (!nextFocused || !block.contains(nextFocused)) {
          isFocusedWithin = false;
          syncTimerLoop();
        }
      },
      { signal }
    );

    // Tab visibility pause
    document.addEventListener(
      'visibilitychange',
      () => {
        syncTimerLoop();
      },
      { signal }
    );

    // Reduced-motion dynamic change listener
    reducedMotionQuery.addEventListener(
      'change',
      (e) => {
        isReducedMotion = e.matches;
        if (isReducedMotion) {
          elapsedMs = 0;
        }
        updateActiveState();
        syncTimerLoop();
      },
      { signal }
    );

    // IntersectionObserver: only run timer while Honors block is visible in viewport
    const io = new IntersectionObserver(
      ([entry]) => {
        isInView = entry.isIntersecting;
        syncTimerLoop();
      },
      { threshold: 0.25 }
    );
    io.observe(block);

    updateActiveState();
    syncTimerLoop();

    return () => {
      stopTimerLoop();
      io.disconnect();
      abort.abort();
    };
  }

  document.addEventListener('astro:page-load', () => {
    setupCertsPagination();
    honorsCleanup?.();
    honorsCleanup = setupHonorsSpotlight();
  });

  document.addEventListener('astro:before-swap', () => {
    if (certsAbortController) {
      certsAbortController.abort();
      certsAbortController = null;
    }
    if (honorsCleanup) {
      honorsCleanup();
      honorsCleanup = null;
    }
  });
</script>
