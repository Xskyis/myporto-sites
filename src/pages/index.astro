---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import ProjectList from '../components/ProjectList.astro';
import TechStack from '../components/TechStack.astro';
import Footer from '../components/Footer.astro';
import { PROFILE } from '../data/profile';
---

<BaseLayout
  title={`${PROFILE.name} | Frontend Developer & Engineering Student`}
  description={`Portfolio of ${PROFILE.name} (Nabil). Frontend Developer specializing in Next.js, React, and modern UI engineering based in Malang, Indonesia.`}
  currentPath="/"
>
  <Hero />
  <About />
  <ProjectList />
  <TechStack />
  <Footer />
</BaseLayout>
