---
import { ClientRouter } from "astro:transitions";
import Navbar from "../components/Navbar.astro";
import CustomCursor from "../components/CustomCursor.astro";
import SplashScreen from "../components/SplashScreen.astro";
import { PROFILE } from "../data/profile";
import { SITE_URL } from "../site";
import { createPageSchema, PROFILE_DESCRIPTION, serializeJsonLd } from "../lib/seo";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  currentPath?: string;
  project?: { name: string; description: string; keywords: string[] };
}

const {
  title = `${PROFILE.name} — ${PROFILE.role}`,
  description = PROFILE_DESCRIPTION,
  image = "/og-image.png",
  imageAlt = `${PROFILE.name} — ${PROFILE.role}`,
  currentPath = "/",
  project,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || SITE_URL);

const pageSchema = createPageSchema({
  site: Astro.site || SITE_URL,
  pathname: Astro.url.pathname,
  title,
  description,
  project,
});
---

<!doctype html>
<html lang="en" data-palette="mono">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={PROFILE.name} />
    <meta name="theme-color" content="#FAFAF9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0A0A0A" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />
    <meta property="og:image:alt" content={imageAlt} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, canonicalURL)} />
    <meta property="twitter:image:alt" content={imageAlt} />

    <!-- JSON-LD Structured Data -->
    <script
      type="application/ld+json"
      set:html={serializeJsonLd(pageSchema)}
    />

    <!-- Astro View Transitions -->
    <ClientRouter />

    <!-- Zero-flash inline theme and splash state loader.
         data-astro-rerun: the ClientRouter replaces <html> attributes on every swap and
         does not re-execute inline scripts by default, which dropped `dark` / `js-anim`
         after client-side navigation. -->
    <script is:inline data-astro-rerun>
      (function () {
        function readStoredValue(storageName, key) {
          try {
            return window[storageName].getItem(key);
          } catch (e) {
            return null;
          }
        }

        function applyThemeAndState(targetHtml) {
          const savedPalette = readStoredValue('localStorage', 'theme-palette');
          targetHtml.setAttribute("data-palette", savedPalette === 'color' ? 'color' : 'mono');

          const savedTone = readStoredValue('localStorage', 'theme-tone');
          const prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches;
          if (savedTone === "dark" || (savedTone !== 'light' && prefersDark)) {
            targetHtml.classList.add("dark");
          } else {
            targetHtml.classList.remove("dark");
          }

          const pathname = window.location.pathname;
          const isHome =
            pathname === "/" || pathname === "" || pathname === "/index.html";
          const params = new URLSearchParams(window.location.search);
          const forceSplash = params.get("splash") === "1";
          const splashShown = readStoredValue('sessionStorage', 'splash_shown') === 'true';

          if (!isHome || (splashShown && !forceSplash)) {
            targetHtml.classList.add("no-splash");
          }

          targetHtml.classList.toggle('js-anim', !window.matchMedia("(prefers-reduced-motion: reduce)").matches);
        }

        applyThemeAndState(document.documentElement);

        // theme-color: the media-query pair in <head> is the no-JS fallback. Once JS runs, the
        // palette switch (mono ↔ poster color) also changes --bg-primary, so collapse the pair
        // into one meta that follows the resolved token instead of duplicating hex values here.
        function syncThemeColor() {
          var bg = getComputedStyle(document.documentElement)
            .getPropertyValue('--bg-primary')
            .trim();
          if (!bg) return;
          var metas = document.querySelectorAll('meta[name="theme-color"]');
          if (metas.length === 1 && !metas[0].hasAttribute('media')) {
            metas[0].setAttribute('content', bg);
            return;
          }
          metas.forEach(function (m) {
            m.remove();
          });
          var meta = document.createElement('meta');
          meta.setAttribute('name', 'theme-color');
          meta.setAttribute('content', bg);
          document.head.appendChild(meta);
        }
        syncThemeColor();
        // This inline script re-runs on every swap (data-astro-rerun), so bind the listeners once.
        if (!window.__themeColorBound) {
          window.__themeColorBound = true;
          window.addEventListener('palette-change', syncThemeColor);
          document.addEventListener('astro:page-load', syncThemeColor);
        }
        // Keep following the OS while the visitor has no saved tone preference.
        // Navbar persists an explicit light/dark choice, which disables this path.
        if (!window.__systemToneBound) {
          window.__systemToneBound = true;
          if (readStoredValue('localStorage', 'theme-tone') !== null) {
            window.__systemToneExplicit = true;
          }
          window.addEventListener('palette-change', function (event) {
            var detail = event.detail;
            if (detail && detail.tone && detail.source !== 'system') {
              window.__systemToneExplicit = true;
            }
          });
          window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (event) {
            if (window.__systemToneExplicit || readStoredValue('localStorage', 'theme-tone') !== null) return;
            document.documentElement.classList.toggle('dark', event.matches);
            window.dispatchEvent(new CustomEvent('palette-change', {
              detail: { tone: event.matches ? 'dark' : 'light', source: 'system' },
            }));
          });
        }

        // The fallback belongs to this page. An outgoing timer must not reveal the
        // next page in the middle of its own entrance animations.
        window.clearTimeout(window.__revealFallbackTimer);
        window.__revealFallbackRevision = (window.__revealFallbackRevision || 0) + 1;
        const revealRevision = window.__revealFallbackRevision;
        if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          window.__revealFallbackTimer = window.setTimeout(function () {
            if (window.__revealFallbackRevision !== revealRevision) return;
            document.documentElement.classList.remove("js-anim");
            window.__revealFallbackTimer = null;
          }, 4000);
        }

        // Stamp theme & cursor classes onto incoming document BEFORE ClientRouter swaps the DOM
        // or captures the ::view-transition-new(root) snapshot, eliminating white flashes in
        // dark / color modes when navigating between home and project detail pages.
        if (!window.__themeBeforeSwapBound) {
          window.__themeBeforeSwapBound = true;
          document.addEventListener("astro:before-swap", function (ev) {
            window.clearTimeout(window.__revealFallbackTimer);
            window.__revealFallbackTimer = null;
            window.__revealFallbackRevision = (window.__revealFallbackRevision || 0) + 1;
            if (!ev || !ev.newDocument) return;
            var currentHtml = document.documentElement;
            var newHtml = ev.newDocument.documentElement;
            var currentPalette = currentHtml.getAttribute("data-palette") || readStoredValue('localStorage', 'theme-palette') || "mono";
            newHtml.setAttribute("data-palette", currentPalette);
            if (currentHtml.classList.contains("dark")) {
              newHtml.classList.add("dark");
            } else {
              newHtml.classList.remove("dark");
            }
            newHtml.classList.add("no-splash");
            if (currentHtml.classList.contains("has-custom-cursor")) {
              newHtml.classList.add("has-custom-cursor");
            }
          });
        }
      })();
    </script>

    <!-- Fallback for JavaScript-disabled environments -->
    <noscript>
      <style>
        #splash-screen {
          display: none !important;
        }
        html:not(.no-splash) #main-header {
          opacity: 1 !important;
          pointer-events: auto !important;
        }
      </style>
    </noscript>
  </head>

  <body
    class="relative min-h-screen bg-[var(--bg-primary)] text-[var(--text-primary)] antialiased selection:bg-[var(--accent-primary)] selection:text-[var(--accent-contrast)]"
  >
    <!-- Skip to main content for accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-[99999] px-4 py-2 bg-[var(--accent-primary)] text-[var(--accent-contrast)] rounded font-mono text-xs shadow-lg"
    >
      Skip to main content
    </a>

    <!-- Editorial Intro Loader (Pure HTML/CSS on First Paint) -->
    <SplashScreen />

    <!-- Subtle Grain Texture Overlay -->
    <div class="grain-overlay" aria-hidden="true"></div>

    <!-- Custom Cursor (Desktop Only) -->
    <CustomCursor />

    <!-- Navbar -->
    <Navbar currentPath={currentPath} />

    <!-- Main Content Container -->
    <main
      id="main-content"
      class="relative z-10 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[var(--border-focus)]"
      tabindex="-1"
    >
      <slot />
    </main>

    <!-- Global Client Init (Lenis + GSAP Animations) -->
    <script>
      import { initLenis, installNavigationScroll } from "../lib/scroll/lenis";
      import { initScrollAnimations } from "../lib/scroll/animations";

      let cleanupAnimations: (() => void) | null = null;

      // Single owner of scroll position across View Transitions (hash offset, Lenis sync,
      // back/forward restoration). Must be registered before the first astro:page-load.
      installNavigationScroll();

      function setupPage() {
        initLenis();

        if (cleanupAnimations) {
          cleanupAnimations();
        }
        cleanupAnimations = initScrollAnimations();
      }

      document.addEventListener("astro:page-load", setupPage);

      document.addEventListener("astro:before-swap", () => {
        if (cleanupAnimations) {
          cleanupAnimations();
          cleanupAnimations = null;
        }
      });
    </script>

  </body>
</html>
